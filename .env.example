# Copy to `.env` (gitignored) and fill in. Alchemy loads `.env` from the repository root.
# Every value below is a placeholder: never commit real secrets.

# The stage's public origin. Its port is also the local dev port.
BETTER_AUTH_URL=http://localhost:1337
# Signs sessions and hashes email codes. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-random-32-byte-secret

# GitHub OAuth app. Callback URL: <BETTER_AUTH_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Google OAuth client. Redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Resend delivers email codes. The sender must be on a domain verified in Resend.
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM=Ditto <sign-in@example.com>

# The shared computer (Cloudflare Containers). Each optional; these are the defaults.
# There is no spending cap: the limit is how many computers may run at once across the stage.
# COMPUTER_INSTANCE_TYPE=standard-1
# COMPUTER_MAX_INSTANCES=2
# Seconds after a start when the computer is destroyed regardless.
# COMPUTER_LIFETIME_SECONDS=3600

# Encrypts the shared computer's stored browser logins, one per stage. Losing or changing it
# loses every stored login. Generate one with: openssl rand -base64 32
COOKIE_ENCRYPTION_KEY=replace-with-a-random-32-byte-secret

# Encrypts every account's stored model connections (OpenCode API keys), one per stage. Losing
# or changing it loses every connection. Generate one with: openssl rand -base64 32
CREDENTIALS_ENCRYPTION_KEY=replace-with-a-random-32-byte-secret

# The included model: `on` offers every account a Workers AI model, so people can start without
# a key of their own. Workers AI bills this Cloudflare account, with no per-account limit yet;
# each request goes through an AI Gateway the stage creates, which logs the Ditto account that
# sent it. Optional, off by default.
# INCLUDED_MODEL=on
