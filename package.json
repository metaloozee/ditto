{
  "name": "ditto",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "alchemy dev --stage dev",
    "feasibility": "cd feasibility && alchemy dev --stage feasibility --no-input --env-file /dev/null",
    "feasibility:model": "node feasibility/model-baseline.ts",
    "feasibility:takeover": "node feasibility/takeover/run.ts",
    "feasibility:free-tier": "node feasibility/free-tier/owner.ts",
    "feasibility:paid": "node feasibility/paid/owner.ts",
    "feasibility:containers": "node feasibility/containers/owner.ts",
    "build": "vp run @ditto/web#build",
    "preview": "vp run @ditto/web#preview",
    "typecheck": "vp run @ditto/web#typecheck",
    "format": "vp fmt",
    "lint": "vp lint",
    "check": "vp check",
    "fix": "vp check --fix",
    "verify": "vp check && vp test run && vp run build",
    "deploy": "alchemy deploy --stage dev",
    "destroy": "alchemy destroy --stage dev",
    "doctor": "react-doctor",
    "test": "vp test run",
    "prepare": "vp config --no-agent"
  },
  "dependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.87",
    "@cloudflare/containers": "0.3.7",
    "@effect/platform-node": "4.1.4",
    "alchemy": "2.0.0-beta.87",
    "effect": "4.1.4"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.6.0",
    "@types/node": "24.19.2",
    "react-doctor": "^0.9.23",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": "^22.22.3 || ^24.11.1 || >=26.0.0"
  },
  "packageManager": "pnpm@12.21.0+sha512.66fd8278ee28935ce951792d34367ff3af5c432a2756445823029533835b8da529bbe0be5130afd56ed0713fb8789e47bad82d93bd5ae2fe54b15562d6276ef0"
}
