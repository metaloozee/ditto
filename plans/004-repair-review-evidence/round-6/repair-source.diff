+export function listCommandsForRun(
+	sql: CoordinatorSql,
+	runId: string,
+	afterSeq: number,
+	limit: number,
+): CommandRow[] {
+	const bounded = boundedIntentLimit(limit);
+	if (bounded <= 0) return [];
+	return sql.query<CommandRow>(
+		`SELECT * FROM commands
+		 WHERE (command_id = ? OR target_run_id = ?)
+		   AND command_seq > ?
+		 ORDER BY command_seq ASC
+		 LIMIT ?`,
+		runId,
+		runId,
+		afterSeq,
+		bounded,
+	);
+}
