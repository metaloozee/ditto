+
+export function persistTerminalProjectionWork(
+	sql: CoordinatorSql,
+	row: {
+		runId: string;
+		ownerVersion: number;
+		status: string;
+		reasonCode: string;
+		originCommandId: string;
+		originAssistantId: string | null;
+		epoch: number;
+	},
+): boolean {
+	const existing = one(
+		sql.query<{ run_id: string }>(
+			`SELECT run_id FROM terminal_projection_work
+			 WHERE run_id = ? AND state = 'pending'`,
+			row.runId,
+		),
+	);
+	if (existing) return false;
+	sql.query(
+		`INSERT OR IGNORE INTO terminal_projection_work (
+			run_id, owner_version, status, reason_code, after_seq,
+			origin_command_id, origin_assistant_id, origin_seen, epoch, state
+		) VALUES (?, ?, ?, ?, 0, ?, ?, 0, ?, 'pending')`,
+		row.runId,
+		row.ownerVersion,
+		row.status,
+		row.reasonCode,
+		row.originCommandId,
+		row.originAssistantId,
+		row.epoch,
+	);
+	return true;
+}
+
+export function listPendingTerminalProjectionWork(
+	sql: CoordinatorSql,
+	limit: number,
+): TerminalProjectionWorkRow[] {
+	const bounded = boundedIntentLimit(limit);
+	if (bounded <= 0) return [];
+	return sql.query<TerminalProjectionWorkRow>(
+		`SELECT * FROM terminal_projection_work
+		 WHERE state = 'pending'
+		 ORDER BY run_id ASC
+		 LIMIT ?`,
+		bounded,
+	);
+}
+
+export function updateTerminalProjectionWorkProgress(
+	sql: CoordinatorSql,
+	runId: string,
+	afterSeq: number,
+	originSeen: boolean,
+): void {
+	sql.query(
+		`UPDATE terminal_projection_work
+		 SET after_seq = ?, origin_seen = ?
+		 WHERE run_id = ? AND state = 'pending'`,
+		afterSeq,
+		originSeen ? 1 : 0,
+		runId,
+	);
+}
+
+export function completeTerminalProjectionWork(
+	sql: CoordinatorSql,
+	runId: string,
+): void {
+	sql.query("DELETE FROM terminal_projection_work WHERE run_id = ?", runId);
+}
+
+export function pendingTerminalProjectionWorkCount(
+	sql: CoordinatorSql,
+): number {
+	return Number(
+		one(
+			sql.query<{ n: number }>(
+				`SELECT count(*) AS n FROM terminal_projection_work
+				 WHERE state = 'pending'`,
+			),
+		)?.n ?? 0,
 	);
 }
 
