+	private async validateReferencedBytes(
+		recordId: string,
+		aadRecordId: string,
+	): Promise<void> {
+		const stored = this.sql.transaction(() =>
+			readCommittedLargeRecord(this.sql, recordId),
+		);
+		if (!stored) throw new Error("missing_referenced_bytes");
+		const manifestAad = commandAad(
+			this.identity,
+			`continuation-manifest:${stored.recordId}`,
+		);
+		const resultManifestAad = commandAad(
+			this.identity,
+			`effect-result-manifest:${stored.recordId}`,
+		);
+		let manifestJson: string;
+		try {
+			manifestJson = await decryptRuntimeText(
+				stored.manifestCiphertext,
+				this.keyring,
+				manifestAad,
+			);
+		} catch {
+			manifestJson = await decryptRuntimeText(
+				stored.manifestCiphertext,
+				this.keyring,
+				resultManifestAad,
+			);
+		}
+		const manifest = parseRuntimeManifest(manifestJson);
+		if (
+			manifest.writeId !== stored.writeId ||
+			manifest.digest !== stored.digest ||
+			manifest.totalLength !== stored.totalLength ||
+			manifest.chunkCount !== stored.chunkCount ||
+			manifest.formatVersion !== stored.formatVersion ||
+			stored.chunks.length !== stored.chunkCount
+		) {
+			throw new Error("referenced_manifest_mismatch");
+		}
+		const fromTable = {
+			...manifest,
+			chunks: stored.chunks.map((chunk) =>
+				parseRuntimeCiphertextV1(chunk.ciphertext),
+			),
+		};
+		await decryptRuntimePayload(
+			{ kind: "chunked", manifest: fromTable },
+			this.keyring,
+			commandAad(this.identity, aadRecordId),
+		);
