+		).rejects.toMatchObject({
+			code: expect.stringMatching(/decrypt_failed|invalid_manifest/),
+		});
+		const reordered = {
+			...first.manifest,
+			chunks: [first.manifest.chunks[1], first.manifest.chunks[0]],
+		};
+		await expect(
+			decryptRuntimePayload(
+				{ kind: "chunked", manifest: reordered },
+				keyring,
+				aad(),
+			),
+		).rejects.toMatchObject({
+			code: expect.stringMatching(/decrypt_failed|invalid_manifest/),
+		});
+		await expect(
+			decryptRuntimePayload(
+				{
+					kind: "chunked",
+					manifest: {
+						...first.manifest,
+						totalLength: 8 * 1024 * 1024 + 1,
+					},
+				},
+				keyring,
+				aad(),
+			),
+		).rejects.toMatchObject({ code: "invalid_manifest" });
