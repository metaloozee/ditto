+export function asRecoveryPointerTarget(
+	payload: ProjectionPayload,
+): RecoveryPointerTarget | null {
+	if (payload.targetKind !== "session") return null;
+	if (payload.targetId !== payload.workspaceSessionId) return null;
+	if (payload.targetId.length === 0) return null;
+	if (!hasTypedRecoveryPointer(payload)) return null;
+	return {
