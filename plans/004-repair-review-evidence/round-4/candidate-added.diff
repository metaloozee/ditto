+	async ensureCanonicalRestore(): Promise<void> {
+		this.initialize();
+		if (this.isFatal()) return;
+		if (this.canonicalRestore === "failed") {
+			this.deny("canonical_restore_failed", "unavailable");
+		}
+		const proof = this.restoreIdentityProof();
+		if (this.restoreProof !== proof) {
+			this.restoreProof = proof;
+			this.restoreCommandSeq = 0;
+			this.restoreEffectRowId = 0;
+			this.restoreContinuationPos = 0;
+			this.canonicalRestore = "unchecked";
+		}
+		if (this.canonicalRestore === "ok") return;
+		const started = this.clock.now();
+		const budgetMs = 5_000;
+		const batch = 25;
+		const budgetRemaining = (): boolean =>
+			this.clock.now() - started < budgetMs;
+		try {
+			const markIncomplete = async (): Promise<never> => {
+				this.canonicalRestore = "incomplete";
+				await this.repairSchedule(this.clock.now() + 1_000);
+				this.deny("canonical_restore_failed", "unavailable");
+			};
+			const restorePages = async <T>(input: {
+				load: (after: number, limit: number) => T[];
+				cursor: () => number;
+				validate: (row: T) => Promise<void>;
+				advance: (row: T) => void;
+			}): Promise<void> => {
+				for (;;) {
+					if (!budgetRemaining()) await markIncomplete();
+					const rows = this.sql.transaction(() =>
+						input.load(input.cursor(), batch),
+					);
+					if (rows.length === 0) return;
+					for (const row of rows) {
+						if (!budgetRemaining()) await markIncomplete();
+						await input.validate(row);
+						input.advance(row);
+					}
+					if (rows.length < batch) {
+						if (!budgetRemaining()) await markIncomplete();
+						return;
+					}
+				}
+			};
+			await restorePages({
+				load: (after, limit) =>
+					this.sql.query<{
+						command_id: string;
+						command_seq: number;
+						kind: string;
+						consumption_state: string;
+						ciphertext: string | null;
+						ciphertext_ref: string | null;
+					}>(
+						`SELECT command_id, command_seq, kind, consumption_state, ciphertext, ciphertext_ref
+						 FROM commands WHERE command_seq > ? ORDER BY command_seq ASC LIMIT ?`,
+						after,
+						limit,
+					),
+				cursor: () => this.restoreCommandSeq,
+				advance: (command) => {
+					this.restoreCommandSeq = Number(command.command_seq);
+				},
+				validate: async (command) => {
+					const shape = this.contentShape(
+						command.ciphertext,
+						command.ciphertext_ref,
+					);
+					if (shape === "conflict") {
+						throw new Error("command_content_conflict");
+					}
+					const required =
+						CONTENT_KINDS.has(command.kind) &&
+						command.consumption_state !== "canceled";
+					if (required && shape === "empty") {
+						throw new Error("command_content_missing");
+					}
+					if (shape === "inline" && command.ciphertext) {
+						await decryptRuntimeText(
+							command.ciphertext,
+							this.keyring,
+							commandAad(this.identity, `command:${command.command_id}`),
+						);
+					}
+					if (shape === "reference" && command.ciphertext_ref) {
+						await this.validateReferencedBytes(
+							command.ciphertext_ref,
+							`command:${command.command_id}`,
+						);
+					}
+				},
+			});
+			await restorePages({
+				load: (after, limit) =>
+					this.sql.query<{
+						rowid: number;
+						state: string;
+						args_ciphertext: string | null;
+						result_ciphertext: string | null;
+						result_ref: string | null;
+						run_id: string;
+						assistant_entry_id: string;
+						tool_call_id: string;
+						attempt: number;
+					}>(
+						`SELECT rowid, state, args_ciphertext, result_ciphertext, result_ref, run_id,
+						        assistant_entry_id, tool_call_id, attempt
+						 FROM effects WHERE rowid > ? ORDER BY rowid ASC LIMIT ?`,
+						after,
+						limit,
+					),
+				cursor: () => this.restoreEffectRowId,
+				advance: (effect) => {
+					this.restoreEffectRowId = Number(effect.rowid);
+				},
+				validate: async (effect) => {
+					if (!effect.args_ciphertext) {
+						throw new Error("effect_args_missing");
+					}
+					await decryptRuntimeText(
+						effect.args_ciphertext,
+						this.keyring,
+						commandAad(
+							this.identity,
+							`effect-args:${effect.run_id}:${effect.assistant_entry_id}:${effect.tool_call_id}:${effect.attempt}`,
+						),
+					);
+					const resultShape = this.contentShape(
+						effect.result_ciphertext,
+						effect.result_ref,
+					);
+					if (resultShape === "conflict") {
+						throw new Error("effect_result_conflict");
+					}
+					if (effect.state === "result_recorded" && resultShape === "empty") {
+						throw new Error("effect_result_missing");
+					}
+					if (resultShape === "inline" && effect.result_ciphertext) {
+						await decryptRuntimeText(
+							effect.result_ciphertext,
+							this.keyring,
+							commandAad(
+								this.identity,
+								`effect-result:${effect.run_id}:${effect.assistant_entry_id}:${effect.tool_call_id}:${effect.attempt}`,
+							),
+						);
+					}
+					if (resultShape === "reference" && effect.result_ref) {
+						await this.validateReferencedBytes(
+							effect.result_ref,
+							`effect-result:${effect.run_id}:${effect.assistant_entry_id}:${effect.tool_call_id}:${effect.attempt}`,
+						);
+					}
+				},
+			});
+			await restorePages({
+				load: (after, limit) =>
+					this.sql.query<{
+						position: number;
+						ciphertext: string | null;
+						ciphertext_ref: string | null;
+						format_version: number;
+					}>(
+						`SELECT position, ciphertext, ciphertext_ref, format_version FROM continuations
+						 WHERE position > ? ORDER BY position ASC LIMIT ?`,
+						after,
+						limit,
+					),
+				cursor: () => this.restoreContinuationPos,
+				advance: (continuation) => {
+					this.restoreContinuationPos = Number(continuation.position);
+				},
+				validate: async (continuation) => {
+					if (
+						Number(continuation.format_version) !==
+						RUNTIME_CRYPTO_FORMAT_VERSION
+					) {
+						throw new Error("continuation_format_incompatible");
+					}
+					await this.decryptContinuationRow(continuation);
+				},
+			});
+			this.canonicalRestore = "ok";
+		} catch (error) {
+			if (
+				this.canonicalRestore === "incomplete" &&
+				error instanceof CoordinatorError
+			) {
+				throw error;
+			}
+			this.canonicalRestore = "failed";
+			this.latchFatalMemoryAndStore();
+			this.deny("canonical_restore_failed", "unavailable");
+		}
+	}
+
+	async readCanonicalContinuation(
+		position: number,
+		caller?: CanonicalReadCaller,
+	): Promise<unknown> {
+		await this.ensureCanonicalRestore();
+		if (!caller?.brainIncarnationId) {
+			this.deny("authority_denied", "forbidden");
+		}
+		const authority = this.assertFreshAuthority(
+			await this.adapters.readCurrentAuthority({
+				workspaceSessionId: this.identity.workspaceSessionId,
+				userId: this.identity.ownerId,
+				projectId: this.identity.projectId,
+			}),
+		);
+		if (authority.projectStatus === "deleting") {
+			this.deny("authority_denied", "forbidden");
+		}
+		if (
+			!this.matchedBrain(
+				authority,
+				caller.brainIncarnationId,
+				caller.lifecycleGeneration,
+			)
+		) {
+			this.deny("authority_denied", "forbidden");
+		}
+		const row = this.sql.transaction(
+			() =>
+				this.sql.query<{
+					position: number;
+					ciphertext: string | null;
+					ciphertext_ref: string | null;
+					format_version: number;
+				}>(
+					"SELECT position, ciphertext, ciphertext_ref, format_version FROM continuations WHERE position = ?",
+					position,
+				)[0],
+		);
+		if (!row) this.deny("continuation_missing", "not_found");
+		const plaintext = await this.decryptContinuationRow(row);
+		return JSON.parse(plaintext) as unknown;
+	}
