+export function listEffectsByRun(
+	sql: CoordinatorSql,
+	runId: string,
+): EffectRow[] {
+	return sql.query<EffectRow>(
+		"SELECT * FROM effects WHERE run_id = ? ORDER BY attempt ASC",
+		runId,
+	);
+}
+
+export function listActiveEffects(sql: CoordinatorSql): EffectRow[] {
+	return sql.query<EffectRow>(
+		`SELECT * FROM effects WHERE state IN ('prepared', 'admitted', 'outcome_unknown')`,
+	);
+}
+
+export function hasUnresolvedWriter(sql: CoordinatorSql): boolean {
+	return (
+		(sql.query<{ n: number }>(
+			`SELECT count(*) AS n
+			 FROM effects e
+			 JOIN runs r ON r.run_id = e.run_id
+			 WHERE e.state IN ('prepared', 'admitted', 'outcome_unknown')
+			   AND r.state NOT IN ('complete', 'failed', 'canceled')`,
+		)[0]?.n ?? 0) > 0
+	);
+}
+
+export function isolationEvidencePresent(sql: CoordinatorSql): boolean {
+	return (
+		(sql.query<{ n: number }>(
+			`SELECT count(*) AS n FROM process_observations
+			 WHERE isolation_evidence_ref IS NOT NULL AND isolation_evidence_ref != ''`,
+		)[0]?.n ?? 0) > 0
+	);
+}
+
+export function nextWorkDeadline(
+	sql: CoordinatorSql,
+	now: number,
+): number | null {
+	const candidates: number[] = [];
+	for (const wakeup of listPendingWakeups(sql)) {
+		candidates.push(Number(wakeup.deadline_at));
+	}
+	for (const run of listRuns(sql)) {
+		if (
+			run.recovery_deadline_at != null &&
+			run.state !== "complete" &&
+			run.state !== "failed" &&
+			run.state !== "canceled"
+		) {
+			candidates.push(Number(run.recovery_deadline_at));
+		}
+	}
+	for (const effect of listActiveEffects(sql)) {
+		candidates.push(Number(effect.deadline));
+	}
+	if (pendingProjectionCount(sql) > 0) {
+		candidates.push(now);
+	}
+	const acceptedGap = sql.query<{ n: number }>(
+		"SELECT count(*) AS n FROM commands WHERE consumption_state = 'accepted'",
+	)[0]?.n;
+	if (Number(acceptedGap ?? 0) > 0) {
+		candidates.push(now);
+	}
+	return candidates.length === 0 ? null : Math.min(...candidates);
+}
