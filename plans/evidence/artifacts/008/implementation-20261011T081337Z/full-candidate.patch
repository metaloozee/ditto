+		| undefined;
+	authenticatedUserId: string;
+	body: unknown;
+}): Promise<{ status: number; body: unknown }> {
+	if (!options.service)
+		return { status: 400, body: { code: "candidate_admission_ineligible" } };
+	try {
+		return {
+			status: 202,
+			body: await options.service.admitOwned(
