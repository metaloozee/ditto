+				version: 2,
+				userId: "owner",
+				projectId: "project",
+				workspaceSessionId: "workspace",
+				runtimeOwnerVersion: 1,
+				acceptedAt: target.acceptedAt,
+				deadlineAt: target.deadlineAt,
