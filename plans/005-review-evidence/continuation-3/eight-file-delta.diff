+export function parseRemoteToolResult(
+	value: unknown,
+	tool: RemoteToolName,
+): RemoteToolResult {
+	const r = strictRecord(
+		decodeContractInput(value, REMOTE_RESULT_BYTES),
+		["content", "details", "isError"],
+		"RemoteToolResult",
+	);
+	if (
+		!Array.isArray(r.content) ||
+		r.content.length < 1 ||
+		r.content.length > 64
+	)
+		throw new ContractParseError(
+			"invalid_field",
+			"Result content must be bounded.",
+		);
+	const content: RemoteToolResult["content"] = r.content.map((value) => {
+		const item = strictRecord(
+			value,
+			["type", "text", "data", "mimeType"],
+			"ResultContent",
+		);
+		if (item.type === "text") {
+			strictRecord(item, ["type", "text"], "TextContent");
+			if (typeof item.text !== "string")
+				throw new ContractParseError(
+					"invalid_field",
+					"Result text must be a string.",
+				);
+			return { type: "text", text: item.text };
+		}
+		strictRecord(item, ["type", "data", "mimeType"], "ImageContent");
+		if (
+			tool !== "read" ||
+			item.type !== "image" ||
+			typeof item.mimeType !== "string" ||
+			!["image/png", "image/jpeg", "image/gif", "image/webp"].includes(
+				item.mimeType,
+			) ||
+			typeof item.data !== "string" ||
+			item.data.length === 0 ||
+			item.data.length % 4 !== 0 ||
+			!/^[A-Za-z0-9+/]+={0,2}$/.test(item.data)
+		)
+			throw new ContractParseError(
+				"invalid_field",
+				"Result image is not allowed.",
+			);
+		return { type: "image", data: item.data, mimeType: item.mimeType };
