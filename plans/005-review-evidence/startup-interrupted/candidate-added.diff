+const fixtures: SessionRuntimeFixture[] = [];
+const workspaces: string[] = [];
+afterEach(async () => {
+	for (const f of fixtures.splice(0)) f.dispose();
+	for (const w of workspaces.splice(0))
+		await rm(w, { recursive: true, force: true });
+	vi.restoreAllMocks();
+});
+async function setup() {
+	const now = Date.now();
+	const workspace = await mkdtemp(path.join(tmpdir(), "ditto-executor-"));
+	workspaces.push(workspace);
+	await writeFile(path.join(workspace, "source.txt"), "sandbox-only");
+	let f: SessionRuntimeFixture;
+	let serializedJob = "";
+	let capturedEnv: Record<string, string> = {};
+	let failAck = false;
+	let environmentRace: (() => Promise<void>) | undefined;
+	const secret = randomBytes(32).toString("hex");
+	const project = randomBytes(32).toString("hex");
+	const launch = { brain: {}, executor: {} };
+	const rpc = {
+		mkdir: vi.fn(async () => undefined),
+		writeFile: vi.fn(async (_file: string, content: string) => {
+			serializedJob = content;
+		}),
+		exec: vi.fn(
+			async (_command: string, options: { env?: Record<string, string> }) => {
+				capturedEnv = options.env ?? {};
+				const job = JSON.parse(serializedJob) as RemoteToolV1;
+				const result = await executeRemoteTool(job, {
+					workspace,
+					incarnation: "synthetic-executor-1",
+					projectValues: capturedEnv.DITTO_EXECUTION_ENV
+						? (JSON.parse(capturedEnv.DITTO_EXECUTION_ENV) as Record<
+								string,
+								string
+							>)
+						: {},
+				});
+				if (failAck) throw new Error("ack_lost");
+				return { stdout: JSON.stringify({ version: 1, result }), exitCode: 0 };
+			},
+		),
+	};
