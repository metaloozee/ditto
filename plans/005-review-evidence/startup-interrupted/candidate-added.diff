+	it("T30 project values enter only an authorized shell, never the serialized job or filesystem tools", async () => {
+		const platform = randomBytes(32).toString("hex");
+		const project = randomBytes(32).toString("hex");
+		const inheritedKey = `DITTO_TEST_${randomBytes(12).toString("hex")}`;
+		process.env[inheritedKey] = platform;
