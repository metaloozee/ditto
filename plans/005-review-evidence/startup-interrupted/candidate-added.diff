+		throw new RemoteToolError("workspace");
+	const timeout = Math.min(
+		job.deadline - now(),
+		job.tool.name === "bash" && job.tool.timeout
+			? job.tool.timeout * 1000
+			: 120_000,
+	);
+	const signal = AbortSignal.any([
+		AbortSignal.timeout(timeout),
+		...(options.signal ? [options.signal] : []),
+	]);
+	checkSignal(signal);
+	const tool = job.tool;
+	let result: RemoteToolResult;
+	if (tool.name === "read") {
+		const target = await workspacePath(root, tool.path);
+		const buffer = await boundedRead(root, target);
+		const mime = imageMime(buffer);
+		if (mime) validateImageDimensions(buffer, mime);
+		else decodeText(buffer);
+		result = await createReadTool(root, {
+			operations: {
+				readFile: async () => buffer,
+				access: async () => undefined,
+				detectImageMimeType: async () => mime,
+			},
+		}).execute(
+			job.toolCallId,
+			{ path: target, offset: tool.offset, limit: tool.limit },
+			signal,
+		);
+	} else if (tool.name === "write") {
+		await conditionalWrite(
+			root,
+			tool.path,
+			tool.content,
+			tool.expected,
+			signal,
+		);
+		result = textResult(`Wrote ${Buffer.byteLength(tool.content)} bytes.`);
+	} else if (tool.name === "edit") {
+		const target = await workspacePath(root, tool.path);
+		const buffer = await boundedRead(root, target);
+		if (contentDigest(buffer) !== tool.expected.sha256)
+			throw new RemoteToolError("expected_content");
+		decodeText(buffer);
+		result = await createEditTool(root, {
+			operations: {
+				access: async () => undefined,
+				readFile: async () => buffer,
+				writeFile: async (_file, content) =>
+					conditionalWrite(root, target, content, tool.expected, signal),
+			},
+		}).execute(job.toolCallId, { path: target, edits: tool.edits }, signal);
+	} else if (tool.name === "bash") {
+		result = await shell(
+			tool,
+			root,
+			closedShellEnvironment(options.projectValues),
+			signal,
+		);
+	} else {
+		const target = await workspacePath(root, tool.path ?? ".");
+		const stat = await lstat(target);
+		if (tool.name === "ls") {
+			if (!stat.isDirectory()) throw new RemoteToolError("path");
+			const entries = await readdir(target, { withFileTypes: true });
+			result = textResult(
+				entries
+					.sort((a, b) => a.name.localeCompare(b.name))
+					.slice(0, tool.limit ?? 500)
+					.map(
+						(entry) =>
+							`${entry.name}${entry.isDirectory() ? "/" : entry.isSymbolicLink() ? "@" : ""}`,
+					)
+					.join("\n"),
+			);
+		} else {
+			result = await remoteSearch(
+				tool,
+				root,
+				target,
+				stat.isDirectory(),
+				signal,
+				async (file) => decodeText(await boundedRead(root, file)),
+			);
+		}
+	}
+	return parseRemoteToolResult(result, tool.name);
+}
