+++ b/apps/runtime/src/startup-platform.ts
@@ -0,0 +1,25 @@
+import type { RuntimeLiveness, StartupAssignment } from "./startup-contract.js";
+
+export type RuntimeLaunchRecord = Pick<RuntimeLiveness,
+ "identityId" | "incarnationId" | "lifecycleGeneration" | "containerId" | "controllerClass" | "controllerNamespace">;
+
+export async function observeRuntimeLaunch(
+ input: StartupAssignment,
+ platform: {
+  containerId: string;
+  controllerClass: "SessionRuntime" | "Sandbox";
+  controllerNamespace: string;
+  readLaunch: () => Promise<RuntimeLaunchRecord | undefined>;
+  running: () => boolean | undefined;
+ },
+): Promise<RuntimeLiveness | null> {
+ const launch = await platform.readLaunch();
+ if (!launch || launch.identityId !== input.identityId || launch.incarnationId !== input.incarnationId ||
+ launch.lifecycleGeneration !== input.lifecycleGeneration || launch.containerId !== platform.containerId ||
+ input.containerId !== platform.containerId || launch.controllerClass !== platform.controllerClass ||
+ input.controllerClass !== platform.controllerClass || launch.controllerNamespace !== platform.controllerNamespace ||
+ input.controllerNamespace !== platform.controllerNamespace) return null;
+ const running = platform.running();
+ if (typeof running !== "boolean") return null;
+ return { ...launch, state: running ? "running" : "terminated" };
+}
