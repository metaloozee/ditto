+			});
+			expect(JSON.stringify(command).includes(project)).toBe(false);
+			expect(
+				Object.values(
+					closedShellEnvironment({ PROJECT_VALUE: project }),
+				).includes(platform),
+			).toBe(false);
+			const result = await execute(command, {
+				projectValues: { PROJECT_VALUE: project },
+			});
+			expect(result.isError).toBe(false);
+			expect(JSON.stringify(result).includes(project)).toBe(false);
+			expect(JSON.stringify(result).includes(platform)).toBe(false);
+			await expect(
+				execute(job({ name: "read", path: "source.txt" }), {
+					projectValues: { PROJECT_VALUE: project },
