+import { spawn } from "node:child_process";
+import { createHash } from "node:crypto";
+import { constants } from "node:fs";
+import { lstat, mkdir, open, readdir, realpath } from "node:fs/promises";
+import path from "node:path";
+import {
+	type ExpectedContent,
+	parseRemoteToolV1,
+	REMOTE_FILE_BYTES,
+	REMOTE_RESULT_BYTES,
+	type RemoteToolV1,
+} from "@ditto/runtime-contracts";
+import {
+	createEditTool,
+	createReadTool,
+} from "@earendil-works/pi-coding-agent";
+
+import { remoteSearch } from "./remote-search.js";
+
+export type RemoteToolResult = {
+	content: (
+		| { type: "text"; text: string }
+		| { type: "image"; data: string; mimeType: string }
+	)[];
+	details?: unknown;
+	isError?: boolean;
+};
+export type RemoteExecutorOptions = {
+	workspace: string;
+	incarnation: string;
+	signal?: AbortSignal;
+	projectValues?: Readonly<Record<string, string>>;
+	now?: () => number;
+};
+
+class RemoteToolError extends Error {
+	constructor(readonly code: string) {
+		super(code);
+	}
+}
+const OUTPUT_BYTES = 128 * 1024;
+export function contentDigest(value: Uint8Array): string {
+	return createHash("sha256").update(value).digest("hex");
+}
+function checkSignal(signal: AbortSignal): void {
+	if (signal.aborted) throw new RemoteToolError("canceled");
+}
+function isInside(root: string, target: string): boolean {
+	return target === root || target.startsWith(`${root}${path.sep}`);
+}
+
+async function workspacePath(
+	root: string,
+	input: string,
+	createParents = false,
+): Promise<string> {
+	if (
+		!input ||
+		input.includes("\0") ||
+		input.startsWith("~") ||
+		input.split(/[\\/]/).includes("..")
+	)
+		throw new RemoteToolError("path");
+	const target = path.resolve(root, input);
+	if (!isInside(root, target)) throw new RemoteToolError("path");
+	const relative = path.relative(root, target);
+	let current = root;
+	for (const [index, part] of relative.split(path.sep).entries()) {
+		if (!part) continue;
+		current = path.join(current, part);
+		try {
+			const stat = await lstat(current);
+			if (stat.isSymbolicLink()) throw new RemoteToolError("symlink");
+			if (index < relative.split(path.sep).length - 1 && !stat.isDirectory())
+				throw new RemoteToolError("path");
+		} catch (error) {
+			if (
+				!(error instanceof Error) ||
+				!("code" in error) ||
+				error.code !== "ENOENT"
+			)
+				throw error;
+			if (createParents && current !== target) await mkdir(current);
+		}
+	}
+	return target;
+}
+async function boundedRead(root: string, input: string): Promise<Buffer> {
+	const target = await workspacePath(root, input);
+	const handle = await open(target, constants.O_RDONLY | constants.O_NOFOLLOW);
+	try {
+		const stat = await handle.stat();
+		if (!stat.isFile() || stat.size > REMOTE_FILE_BYTES)
+			throw new RemoteToolError("file_limit");
+		if (!isInside(root, await realpath(`/proc/self/fd/${handle.fd}`)))
+			throw new RemoteToolError("path");
+		const buffer = Buffer.alloc(REMOTE_FILE_BYTES + 1);
+		let size = 0;
+		while (size < buffer.length) {
+			const read = await handle.read(buffer, size, buffer.length - size, size);
+			if (read.bytesRead === 0) break;
+			size += read.bytesRead;
+		}
+		if (size > REMOTE_FILE_BYTES) throw new RemoteToolError("file_limit");
+		return buffer.subarray(0, size);
+	} finally {
+		await handle.close();
