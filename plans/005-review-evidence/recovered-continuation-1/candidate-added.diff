+			operations: {
+				readFile: async () => buffer,
+				access: async () => undefined,
+				detectImageMimeType: async () => mime,
+			},
+		}).execute(
+			job.toolCallId,
+			{ path: target, offset: tool.offset, limit: tool.limit },
+			signal,
+		);
+	} else if (tool.name === "write") {
+		await conditionalWrite(
+			root,
+			tool.path,
+			tool.content,
+			tool.expected,
+			signal,
+		);
