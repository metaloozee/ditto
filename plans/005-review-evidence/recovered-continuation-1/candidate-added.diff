@@ -0,0 +1,69 @@
+#!/usr/bin/env node
+import { constants } from "node:fs";
+import { open } from "node:fs/promises";
+import { parseRemoteToolV1, REMOTE_JOB_BYTES } from "@ditto/runtime-contracts";
+import { executeRemoteTool } from "./remote-tool.js";
+
+async function main(): Promise<void> {
+	const [jobPath, incarnation] = process.argv.slice(2);
+	if (
+		!jobPath ||
+		!/^\/tmp\/ditto-remote-jobs\/[a-f0-9-]{36}\.json$/.test(jobPath) ||
+		!incarnation ||
+		process.argv.length !== 4
+	)
+		throw new Error("protocol");
+	const handle = await open(jobPath, constants.O_RDONLY | constants.O_NOFOLLOW);
+	let raw: string;
+	try {
+		const stat = await handle.stat();
+		if (!stat.isFile() || stat.size > REMOTE_JOB_BYTES)
+			throw new Error("job_limit");
+		const buffer = Buffer.alloc(REMOTE_JOB_BYTES + 1);
+		let size = 0;
+		while (size < buffer.length) {
+			const next = await handle.read(buffer, size, buffer.length - size, size);
+			if (next.bytesRead === 0) break;
+			size += next.bytesRead;
+		}
+		if (size > REMOTE_JOB_BYTES) throw new Error("job_limit");
+		raw = new TextDecoder("utf-8", { fatal: true }).decode(
+			buffer.subarray(0, size),
+		);
+	} finally {
+		await handle.close();
+	}
+	const job = parseRemoteToolV1(raw);
+	const materialized = process.env.DITTO_EXECUTION_ENV;
+	delete process.env.DITTO_EXECUTION_ENV;
+	let projectValues: Record<string, string> = {};
+	if (materialized) {
+		if (
+			job.tool.name !== "bash" ||
+			Buffer.byteLength(materialized) > 256 * 1024
+		)
+			throw new Error("environment");
+		const value: unknown = JSON.parse(materialized);
+		if (
+			!value ||
+			typeof value !== "object" ||
+			Array.isArray(value) ||
+			!Object.values(value).every((item) => typeof item === "string")
+		)
+			throw new Error("environment");
+		projectValues = value as Record<string, string>;
+	}
+	const result = await executeRemoteTool(job, {
+		workspace: "/workspace",
+		incarnation,
+		projectValues,
+	});
+	process.stdout.write(`${JSON.stringify({ version: 1, result })}\n`);
+}
+
+void main().catch(() => {
+	process.stdout.write(
+		`${JSON.stringify({ version: 1, error: "remote_tool_failed" })}\n`,
+	);
+	process.exitCode = 1;
+});
