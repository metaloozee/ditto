+			},
+		}).execute(job.toolCallId, { path: target, edits: tool.edits }, signal);
+	} else if (tool.name === "bash") {
+		result = await shell(
+			tool,
+			root,
+			closedShellEnvironment(options.projectValues),
+			signal,
+		);
+	} else {
+		const target = await workspacePath(root, tool.path ?? ".");
