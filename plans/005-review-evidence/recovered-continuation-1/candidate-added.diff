new file mode 100644
index 0000000..7d53681
--- /dev/null
+++ b/apps/runtime/src/brain-dispatch.ts
@@ -0,0 +1,61 @@
+import { strictRecord } from "../../../packages/runtime-contracts/src/json.js";
+import { parseRemoteToolV1 } from "../../../packages/runtime-contracts/src/remote-tool.js";
+import type { BrainRequest } from "./brain-transport.js";
+import { TransportDenied } from "./brain-transport.js";
+import { continuationPosition } from "./journal.js";
+import type { RuntimeSource } from "./runtime-egress.js";
+import type { SessionCoordinator } from "./session-runtime.js";
+
+export async function dispatchBrainRequest(
+	coordinator: SessionCoordinator,
+	source: RuntimeSource,
+	request: BrainRequest,
+): Promise<unknown> {
+	if (
+		coordinator.identity.workspaceSessionId !== source.workspaceSessionId ||
+		coordinator.identity.ownerId !== source.userId ||
+		coordinator.identity.projectId !== source.projectId ||
+		request.deadline <= coordinator.clock.now()
+	)
+		throw new TransportDenied("coordinator_identity");
+	if (request.kind === "readiness") return { ready: true, terminal: false };
+	if (request.kind === "continuation")
+		return coordinator.commitContinuation({
+			expectedPosition: request.expectedCommittedPosition,
+			snapshot: request.payload,
+			runId: request.runId,
+			brainIncarnationId: source.incarnation,
+			lifecycleGeneration: source.lifecycleGeneration,
+			ownerVersion: source.ownerVersion,
+			runEpoch: request.runEpoch,
+		});
+	if (request.kind === "tool" || request.kind === "result") {
+		const job = parseRemoteToolV1(request.payload);
+		if (
+			job.runId !== request.runId ||
+			job.runEpoch !== request.runEpoch ||
+			job.attempt !== request.attempt ||
+			job.lifecycleGeneration !== source.lifecycleGeneration ||
+			job.deadline > request.deadline
+		)
+			throw new TransportDenied("effect_envelope");
+		if (
+			request.expectedCommittedPosition < 1 ||
+			request.expectedCommittedPosition !==
+				continuationPosition(coordinator.sql)
+		)
+			throw new TransportDenied("continuation_position");
+		if (request.kind === "tool") {
+			const { tool, ...identity } = job;
+			await coordinator.admitEffect({
+				...identity,
+				arguments: tool,
+				state: "prepared",
+			});
+		}
+		return coordinator.readEffectResult(job);
+	}
+	const control = strictRecord(request.payload, ["action"], "BrainControl");
+	if (control.action === "read_snapshot") return coordinator.readSnapshot();
+	throw new TransportDenied("control_action");
+}
diff --git a/apps/runtime/src/brain-transport.ts b/apps/runtime/src/brain-transport.ts
new file mode 100644
index 0000000..7f67ac4
--- /dev/null
+++ b/apps/runtime/src/brain-transport.ts
@@ -0,0 +1,181 @@
+import {
+	decodeContractInput,
+	integerField,
+	literalField,
+	strictRecord,
+} from "../../../packages/runtime-contracts/src/json.js";
+import {
+	type BrainEnvelopeV1,
+	parseBrainEnvelopeV1,
+} from "../../../packages/runtime-contracts/src/runtime.js";
+
+export const BRAIN_ORIGIN = "http://ditto.internal";
+export const BRAIN_BODY_LIMIT = 256 * 1024;
+export const BRAIN_READ_TIMEOUT_MS = 5_000;
+export const BRAIN_METHODS = [
+	"readiness",
+	"continuation",
+	"tool",
+	"result",
+	"control",
+] as const;
+export type BrainMethod = (typeof BRAIN_METHODS)[number];
+export type BrainRequest = BrainEnvelopeV1 & {
+	kind: BrainMethod;
+	ownerVersion: number;
+	lifecycleGeneration: number;
+	deadline: number;
+};
+
+export class TransportDenied extends Error {
+	constructor(readonly code: string) {
+		super(code);
+		this.name = "TransportDenied";
+	}
+}
+
+export function transportDenial(code: string, status = 403): Response {
+	return Response.json({ error: "denied", reasonCode: code }, { status });
+}
+
+export async function readTransportBody(request: Request): Promise<string> {
+	if (
+		request.headers.get("content-type")?.toLowerCase() !== "application/json"
+	) {
+		throw new TransportDenied("content_type");
+	}
+	if (request.headers.has("content-encoding"))
+		throw new TransportDenied("encoding");
+	for (const [name] of request.headers) {
+		if (
+			![
+				"content-type",
+				"content-length",
+				"host",
+				"accept",
+				"user-agent",
+			].includes(name)
+		) {
+			throw new TransportDenied("unexpected_header");
+		}
+	}
+	const length = request.headers.get("content-length");
+	if (
+		length != null &&
+		(!/^\d+$/.test(length) || Number(length) > BRAIN_BODY_LIMIT)
+	) {
+		throw new TransportDenied("body_limit");
+	}
+	const reader = request.body?.getReader();
+	if (!reader) throw new TransportDenied("body_missing");
+	const chunks: Uint8Array[] = [];
+	let size = 0;
+	let cancelBody: () => void = () => undefined;
+	const interrupted = new Promise<never>((_resolve, reject) => {
+		cancelBody = () => reject(new TransportDenied("body_canceled"));
+	});
+	const timer = setTimeout(() => {
+		cancelTimeout(new TransportDenied("body_timeout"));
+		void reader.cancel().catch(() => undefined);
+	}, BRAIN_READ_TIMEOUT_MS);
+	let cancelTimeout: (error: Error) => void = () => undefined;
+	const expired = new Promise<never>((_resolve, reject) => {
+		cancelTimeout = reject;
+	});
+	request.signal.addEventListener("abort", cancelBody, { once: true });
+	if (request.signal.aborted) cancelBody();
+	try {
+		while (true) {
+			const chunk = await Promise.race([reader.read(), interrupted, expired]);
+			if (chunk.done) break;
+			size += chunk.value.byteLength;
+			if (size > BRAIN_BODY_LIMIT) throw new TransportDenied("body_limit");
+			chunks.push(chunk.value);
+		}
+	} catch (error) {
+		void reader.cancel().catch(() => undefined);
+		throw error;
+	} finally {
+		clearTimeout(timer);
+		request.signal.removeEventListener("abort", cancelBody);
+		reader.releaseLock();
+	}
+	const bytes = new Uint8Array(size);
+	let offset = 0;
+	for (const chunk of chunks) {
+		bytes.set(chunk, offset);
+		offset += chunk.byteLength;
+	}
+	if (length != null && Number(length) !== size)
+		throw new TransportDenied("body_length");
+	try {
+		return new TextDecoder("utf-8", { fatal: true }).decode(bytes);
+	} catch {
+		throw new TransportDenied("utf8");
+	}
+}
+
+export async function parseBrainRequest(
+	request: Request,
+	now: number | (() => number) = Date.now,
+): Promise<BrainRequest> {
+	const clock =
+		typeof now === "function" ? now : () => Math.max(now, Date.now());
+	const startedAt = typeof now === "function" ? now() : now;
+	const url = new URL(request.url);
+	if (
+		url.origin !== BRAIN_ORIGIN ||
+		url.username ||
+		url.password ||
+		url.search ||
+		url.hash
+	) {
+		throw new TransportDenied("origin");
+	}
+	if (request.method !== "POST") throw new TransportDenied("method");
+	const raw = await readTransportBody(request);
+	const record = strictRecord(
+		decodeContractInput(raw, BRAIN_BODY_LIMIT),
+		[
+			"version",
+			"kind",
+			"ownerVersion",
+			"lifecycleGeneration",
+			"deadline",
+			"brainIdentityId",
+			"brainIncarnationId",
+			"runId",
+			"attempt",
+			"runEpoch",
+			"operationId",
+			"expectedCommittedPosition",
+			"payload",
+		],
+		"BrainRequestV1",
+	);
+	const kind = literalField(record, "kind", BRAIN_METHODS);
+	if (url.pathname !== `/v1/${kind}`) throw new TransportDenied("path");
+	const deadline = integerField(record, "deadline", { minimum: 1 });
+	if (deadline <= clock() || deadline > startedAt + 120_000)
+		throw new TransportDenied("deadline");
+	const {
+		kind: _kind,
+		ownerVersion,
+		lifecycleGeneration,
+		deadline: _deadline,
+		...envelope
+	} = record;
+	return {
+		...parseBrainEnvelopeV1(envelope),
+		kind,
+		ownerVersion: integerField({ ownerVersion }, "ownerVersion", {
+			minimum: 1,
+		}),
+		lifecycleGeneration: integerField(
+			{ lifecycleGeneration },
+			"lifecycleGeneration",
+			{ minimum: 1 },
+		),
+		deadline,
+	};
+}
diff --git a/apps/runtime/src/executor-dispatch.ts b/apps/runtime/src/executor-dispatch.ts
new file mode 100644
index 0000000..cfc6eae
--- /dev/null
+++ b/apps/runtime/src/executor-dispatch.ts
@@ -0,0 +1,174 @@
+import type { ExecOptions } from "@cloudflare/sandbox";
+import {
+	decodeContractInput,
+	strictRecord,
+} from "../../../packages/runtime-contracts/src/json.js";
+import {
+	parseRemoteToolV1,
+	REMOTE_RESULT_BYTES,
+} from "../../../packages/runtime-contracts/src/remote-tool.js";
+import { redactStructured } from "../../web/src/lib/secret-redaction.js";
+import type { EffectExecutor } from "./session-runtime.js";
+
+export type ExecutorRpc = {
+	mkdir(path: string, options: { recursive: boolean }): Promise<unknown>;
+	writeFile(path: string, content: string): Promise<unknown>;
+	exec(
+		command: string,
+		options: ExecOptions,
+	): Promise<{ stdout: string; exitCode: number }>;
+};
+export type ExecutionEnvironmentReference = {
+	effectId: string;
+	identityId: string;
+	incarnation: string;
+	ownerVersion: number;
+};
+export async function effectReference(input: {
+	runId: string;
+	assistantEntryId: string;
+	toolCallId: string;
+	attempt: number;
+}): Promise<string> {
+	const bytes = new TextEncoder().encode(
+		JSON.stringify([
+			input.runId,
+			input.assistantEntryId,
+			input.toolCallId,
+			input.attempt,
+		]),
+	);
+	return [...new Uint8Array(await crypto.subtle.digest("SHA-256", bytes))]
+		.map((byte) => byte.toString(16).padStart(2, "0"))
+		.join("");
+}
+function quote(value: string): string {
+	return `'${value.replaceAll("'", "'\\''")}'`;
+}
+
+export function createEffectExecutor(deps: {
+	db: D1Database;
+	controllerNamespace: string;
+	identity: { ownerId: string; workspaceSessionId: string; projectId: string };
+	resolveSandbox: (sandboxId: string) => ExecutorRpc;
+	executionEnvironment: (
+		input: ExecutionEnvironmentReference,
+	) => Promise<Record<string, string>>;
+	now?: () => number;
+}): EffectExecutor {
+	return async ({ effect, executorIdentityId, ownerVersion, revalidate }) => {
+		const now = deps.now ?? Date.now;
+		const { state: _state, arguments: tool, ...identity } = effect;
+		const job = parseRemoteToolV1({ ...identity, tool });
+		const effectId = await effectReference(effect);
+		await revalidate();
+		const resolveTarget = () =>
+			deps.db
+				.prepare(`SELECT i.sandboxId FROM sandbox_identities i
+			JOIN workspace_sessions s ON s.id = i.workspaceSessionId AND s.userId = i.userId AND s.projectId = i.projectId
+			JOIN projects p ON p.id = i.projectId AND p.userId = i.userId
+			WHERE i.id = ? AND i.incarnationId = ? AND i.lifecycleGeneration = ? AND i.controllerClass = 'Sandbox'
+			AND i.controllerNamespace = ? AND i.kind = 'workspace_session' AND i.retiredAt IS NULL AND i.state = 'ready'
+			AND s.id = ? AND s.userId = ? AND s.projectId = ? AND s.sandboxIdentityId = i.id
+			AND s.runtimeOwner = 'trusted_v1' AND s.runtimeOwnerVersion = ? AND s.status = 'active' AND p.status != 'deleting'
+			AND NOT EXISTS (SELECT 1 FROM runtime_deleted_target_fences f WHERE (f.targetKind = 'project' AND f.targetId = p.id)
+				OR (f.targetKind = 'workspace_session' AND f.targetId = s.id))`)
+				.bind(
+					executorIdentityId,
+					effect.executorIncarnationId,
+					effect.lifecycleGeneration,
+					deps.controllerNamespace,
+					deps.identity.workspaceSessionId,
+					deps.identity.ownerId,
+					deps.identity.projectId,
+					ownerVersion,
+				)
+				.first<{ sandboxId: string }>();
+		const target = await resolveTarget();
+		if (!target || job.deadline <= now())
+			throw new Error("execution_authority");
+		const guard = async () => {
+			await revalidate();
+			const current = await resolveTarget();
+			if (
+				!current ||
+				current.sandboxId !== target.sandboxId ||
+				job.deadline <= now()
+			)
+				throw new Error("execution_authority");
+		};
+		await deps.db
+			.prepare(`INSERT INTO runtime_execution_admissions
+			(effectId, sessionId, userId, projectId, identityId, incarnationId, lifecycleGeneration, ownerVersion, runId, runEpoch,
+			assistantEntryId, toolCallId, attempt, toolName, deadline, closedAt)
+			VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, NULL)`)
+			.bind(
+				effectId,
+				deps.identity.workspaceSessionId,
+				deps.identity.ownerId,
+				deps.identity.projectId,
+				executorIdentityId,
+				effect.executorIncarnationId,
+				effect.lifecycleGeneration,
+				ownerVersion,
+				effect.runId,
+				effect.runEpoch,
+				effect.assistantEntryId,
+				effect.toolCallId,
+				effect.attempt,
+				job.tool.name,
+				job.deadline,
+			)
+			.run();
+		try {
+			const sandbox = deps.resolveSandbox(target.sandboxId);
+			const jobPath = `/tmp/ditto-remote-jobs/${crypto.randomUUID()}.json`;
+			await guard();
+			await sandbox.mkdir("/tmp/ditto-remote-jobs", { recursive: true });
+			await guard();
+			await sandbox.writeFile(jobPath, JSON.stringify(job));
+			await guard();
+			const reference = {
+				effectId,
+				identityId: executorIdentityId,
+				incarnation: effect.executorIncarnationId,
+				ownerVersion,
+			};
+			let values: Record<string, string> = {};
+			if (job.tool.name === "bash")
+				values = await deps.executionEnvironment(reference);
+			await guard();
+			const command = `/usr/bin/env -i PATH=/usr/local/bin:/usr/bin:/bin HOME=/tmp LANG=C.UTF-8 DITTO_EXECUTION_ENV="$DITTO_EXECUTION_ENV" /usr/local/bin/node /opt/ditto-runner/dist/remote-tool-cli.js ${quote(jobPath)} ${quote(job.executorIncarnationId)}`;
+			// One RPC only. An ambiguous acknowledgement never retries the command.
+			const response = await sandbox.exec(command, {
+				cwd: "/workspace",
+				timeout: Math.max(1, job.deadline - now()),
+				env:
+					job.tool.name === "bash"
+						? { DITTO_EXECUTION_ENV: JSON.stringify(values) }
+						: {},
+				origin: "internal",
+			});
+			const parsed = strictRecord(
+				decodeContractInput(response.stdout, REMOTE_RESULT_BYTES + 1024),
+				["version", "result", "error"],
+				"ExecutorResult",
+			);
+			if (
+				parsed.version !== 1 ||
+				response.exitCode !== 0 ||
+				parsed.error !== undefined ||
+				parsed.result === undefined
+			)
+				throw new Error("executor_acknowledgement");
+			return redactStructured(parsed.result, Object.values(values));
+		} finally {
+			await deps.db
+				.prepare(
+					"UPDATE runtime_execution_admissions SET closedAt = ? WHERE effectId = ? AND closedAt IS NULL",
+				)
+				.bind(now(), effectId)
+				.run();
+		}
+	};
+}
diff --git a/apps/runtime/src/runtime-bindings.ts b/apps/runtime/src/runtime-bindings.ts
