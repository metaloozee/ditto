index 0000000..b5cab19
--- /dev/null
+++ b/apps/web/src/lib/runtime-binding-graph.test.ts
@@ -0,0 +1,149 @@
+import { readFileSync } from "node:fs";
+import path from "node:path";
+import ts from "typescript";
+import { describe, expect, it } from "vitest";
+
+const root = new URL("../../../../", import.meta.url).pathname;
+const web = path.join(root, "apps/web/src");
+function source(file: string): ts.SourceFile {
+	return ts.createSourceFile(
+		file,
+		readFileSync(file, "utf8"),
+		ts.ScriptTarget.Latest,
+		true,
+	);
+}
+function properties(value: ts.Node | undefined): Map<string, ts.Expression> {
+	if (!value || !ts.isObjectLiteralExpression(value))
+		throw new Error("Expected binding object");
+	return new Map(
+		value.properties.map((property) => {
+			if (
+				!ts.isPropertyAssignment(property) &&
+				!ts.isShorthandPropertyAssignment(property)
+			)
+				throw new Error("Unexpected binding declaration");
+			const key =
+				ts.isIdentifier(property.name) || ts.isStringLiteral(property.name)
+					? property.name.text
+					: property.name.getText();
+			return [
+				key,
+				ts.isPropertyAssignment(property)
+					? property.initializer
+					: property.name,
+			];
+		}),
+	);
+}
+function worker(name: string): Map<string, ts.Expression> {
+	let declaration: ts.CallExpression | undefined;
+	function visit(node: ts.Node): void {
+		if (
+			ts.isCallExpression(node) &&
+			ts.isIdentifier(node.expression) &&
+			node.expression.text === "Worker" &&
+			node.arguments[0] &&
+			ts.isStringLiteral(node.arguments[0]) &&
+			node.arguments[0].text === name
+		)
+			declaration = node;
+		ts.forEachChild(node, visit);
+	}
+	visit(source(path.join(root, "alchemy.run.ts")));
+	if (!declaration) throw new Error("Worker declaration missing");
+	return properties(declaration.arguments[1]);
+}
+
+describe("local target binding and runtime import graph", () => {
+	it("grants only the intended counterpart each named capability and leaves legacy deployment intact", () => {
+		const product = worker("local-product-bridge");
+		const runtime = worker("local-session-runtime");
+		expect(product.get("entrypoint")?.getText()).toBe(
+			'"apps/web/src/lib/runtime-product-worker.ts"',
+		);
+		const p = properties(product.get("bindings"));
+		const r = properties(runtime.get("bindings"));
+		expect(p.get("RUNTIME")?.getText()).toContain(
+			'Worker.experimentalEntrypoint(runtimeRef, "RuntimeEntrypoint")',
+		);
+		expect(r.get("PRODUCT")?.getText()).toContain(
+			'Worker.experimentalEntrypoint(productRef, "ProductEntrypoint")',
+		);
+		for (const key of [
+			"SessionRuntime",
+			"Sandbox",
+			"OPENCODE_API_KEY",
+			"RUNTIME_ENCRYPTION_KEYS",
+			"PRODUCT",
+		])
+			expect(p.has(key)).toBe(false);
+		for (const key of [
+			"BETTER_AUTH_SECRET",
+			"GITHUB_APP_PRIVATE_KEY",
+			"GITHUB_CLIENT_SECRET",
+			"RUNTIME",
+		])
+			expect(r.has(key)).toBe(false);
+		expect(r.has("SessionRuntime")).toBe(true);
+		expect(r.has("Sandbox")).toBe(true);
+		expect(r.has("DB") && p.has("DB")).toBe(true);
+		const alchemy = readFileSync(path.join(root, "alchemy.run.ts"), "utf8");
+		expect(
+			alchemy.includes(
+				'app.local && process.env.DITTO_LOCAL_RUNTIME_TOPOLOGY === "1"',
+			),
+		).toBe(true);
+		expect(
+			alchemy.includes('export const website = await TanStackStart("website"'),
+		).toBe(true);
+	});
+	it("runtime value imports cannot initialize product auth or mint GitHub tokens", () => {
+		const queue = [path.join(root, "apps/runtime/src/server.ts")];
+		const visited = new Set<string>();
+		while (queue.length) {
+			const file = queue.pop();
+			if (!file || visited.has(file)) continue;
+			visited.add(file);
+			expect(
+				[
+					"auth.ts",
+					"github-app.ts",
+					"runtime-product-service.ts",
+					"session-runtime-product.ts",
+				].includes(path.basename(file)),
+			).toBe(false);
+			const parsed = source(file);
+			function add(spec: string): void {
+				let candidate: string;
+				if (spec.startsWith("#/")) candidate = path.join(web, spec.slice(2));
+				else if (spec.startsWith("."))
+					candidate = path.resolve(path.dirname(file ?? ""), spec);
+				else return;
+				candidate = candidate.replace(/\.(js|ts)$/, "");
+				queue.push(`${candidate}.ts`);
+			}
+			function visit(node: ts.Node): void {
+				if (
+					ts.isImportDeclaration(node) &&
+					ts.isStringLiteral(node.moduleSpecifier) &&
+					!node.importClause?.isTypeOnly
+				)
+					add(node.moduleSpecifier.text);
+				if (
+					ts.isCallExpression(node) &&
+					node.expression.kind === ts.SyntaxKind.ImportKeyword &&
+					node.arguments[0] &&
+					ts.isStringLiteral(node.arguments[0])
+				)
+					add(node.arguments[0].text);
+				ts.forEachChild(node, visit);
+			}
+			visit(parsed);
+		}
+		expect(
+			visited.has(path.join(root, "apps/runtime/src/runtime-egress.ts")),
+		).toBe(true);
+		expect(visited.has(path.join(web, "lib/open-code-contract.ts"))).toBe(true);
+	});
+});
