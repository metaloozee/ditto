+import type { LocalRuntimeEnv } from "../../../alchemy.run";
+import type { Sandbox, SessionRuntime } from "./server";
+import type { ProductAdapters } from "./session-runtime";
+
+export type RuntimeProductService = ProductAdapters & {
+	resolveWorkspaceSessionId(commandId: string): Promise<string | null>;
+};
+
+export type RuntimeEnv = Omit<
+	LocalRuntimeEnv,
+	"PRODUCT" | "SessionRuntime" | "Sandbox"
+> & {
+	PRODUCT: RuntimeProductService;
+	SessionRuntime: DurableObjectNamespace<SessionRuntime>;
+	Sandbox: DurableObjectNamespace<Sandbox>;
+};
diff --git a/apps/runtime/src/runtime-egress.ts b/apps/runtime/src/runtime-egress.ts
new file mode 100644
index 0000000..c173620
--- /dev/null
+++ b/apps/runtime/src/runtime-egress.ts
@@ -0,0 +1,212 @@
+import {
+	classifyDittoActionRequest,
+	isDittoSyntheticHost,
+} from "../../web/src/lib/ditto-action-contract";
+import { classifyGithubGitRequest } from "../../web/src/lib/git-fetch-contract";
+import { classifyOpenCodeRequest } from "../../web/src/lib/open-code-contract";
+import { handlePublicInternet } from "../../web/src/lib/sandbox-public-egress";
+import {
+	type BrainRequest,
+	parseBrainRequest,
+	TransportDenied,
+	transportDenial,
+} from "./brain-transport";
+
+export type RuntimeSource = {
+	identityId: string;
+	containerId: string;
+	className: string;
+	kind: "trusted_brain" | "workspace_session" | "project_seed";
+	incarnation: string;
+	lifecycleGeneration: number;
+	ownerVersion: number;
+	userId: string;
+	projectId: string;
+	workspaceSessionId: string | null;
+};
+export type PlatformOutboundContext = {
+	containerId: string;
+	className: string;
+	params?: unknown;
+};
+export type RuntimeEgressEnv = {
+	DB: D1Database;
+	RUNTIME_CONTROLLER_NAMESPACE: string;
+};
+export type BrainDispatch = (
+	source: RuntimeSource,
+	request: BrainRequest,
+) => Promise<unknown>;
+
+export async function resolveRuntimeSource(
+	env: RuntimeEgressEnv,
+	ctx: PlatformOutboundContext,
+): Promise<RuntimeSource> {
+	if (
+		!ctx.containerId ||
+		!["SessionRuntime", "Sandbox"].includes(ctx.className)
+	)
+		throw new TransportDenied("source");
+	if (
+		!ctx.params ||
+		typeof ctx.params !== "object" ||
+		Array.isArray(ctx.params)
+	)
+		throw new TransportDenied("launch_identity");
+	const params = ctx.params as Record<string, unknown>;
+	if (
+		typeof params.incarnation !== "string" ||
+		!params.incarnation ||
+		!Number.isSafeInteger(params.lifecycleGeneration)
+	)
+		throw new TransportDenied("launch_identity");
+	const row = await env.DB.prepare(`
+		SELECT i.id AS identityId, i.containerId, i.controllerClass AS className,
+			i.kind, i.incarnationId AS incarnation, i.lifecycleGeneration,
+			i.userId, i.projectId, i.workspaceSessionId,
+			coalesce(s.runtimeOwnerVersion, 1) AS ownerVersion
+		FROM sandbox_identities i JOIN projects p ON p.id = i.projectId AND p.userId = i.userId
+		LEFT JOIN workspace_sessions s ON s.id = i.workspaceSessionId
+		WHERE i.containerId = ? AND i.controllerClass = ? AND i.controllerNamespace = ?
+			AND i.incarnationId = ? AND i.lifecycleGeneration = ?
+			AND i.retiredAt IS NULL AND i.state NOT IN ('destroyed', 'destroying')
+			AND p.status != 'deleting'
+			AND NOT EXISTS (SELECT 1 FROM runtime_deleted_target_fences f WHERE
+				(f.targetKind = 'project' AND f.targetId = i.projectId) OR
+				(f.targetKind = 'workspace_session' AND f.targetId = i.workspaceSessionId))
+			AND ((i.kind = 'project_seed' AND i.workspaceSessionId IS NULL AND i.controllerClass = 'Sandbox') OR
+				(s.userId = i.userId AND s.projectId = i.projectId AND s.status = 'active' AND s.runtimeOwner = 'trusted_v1'
+				AND ((i.kind = 'trusted_brain' AND i.controllerClass = 'SessionRuntime' AND s.brainIdentityId = i.id) OR
+					(i.kind = 'workspace_session' AND i.controllerClass = 'Sandbox' AND s.sandboxIdentityId = i.id))))
+		LIMIT 2
+	`)
+		.bind(
+			ctx.containerId,
+			ctx.className,
+			env.RUNTIME_CONTROLLER_NAMESPACE,
+			params.incarnation,
+			params.lifecycleGeneration,
+		)
+		.all<RuntimeSource>();
+	if (row.results.length !== 1) throw new TransportDenied("source_authority");
+	return row.results[0];
+}
+
+export async function authorizeBrainRequest(
+	env: RuntimeEgressEnv,
+	source: RuntimeSource,
+	request: BrainRequest,
+	now: number,
+): Promise<void> {
+	if (
+		source.kind !== "trusted_brain" ||
+		source.className !== "SessionRuntime" ||
+		!source.workspaceSessionId
+	)
+		throw new TransportDenied("brain_role");
+	if (
+		request.brainIdentityId !== source.identityId ||
+		request.brainIncarnationId !== source.incarnation ||
+		request.lifecycleGeneration !== source.lifecycleGeneration ||
+		request.ownerVersion !== source.ownerVersion
+	)
+		throw new TransportDenied("source_mismatch");
+	if (request.kind === "readiness") {
+		const intent =
+			await env.DB.prepare(`SELECT w.id FROM workspace_runtime_work w
+			JOIN session_commands c ON c.id = w.commandId AND c.sessionId = w.sessionId
+			JOIN workspace_sessions s ON s.id = w.sessionId
+			JOIN projects p ON p.id = w.projectId AND p.userId = w.userId
+			WHERE w.id = ? AND w.sessionId = ? AND w.userId = ? AND w.projectId = ?
+				AND w.runtimeOwner = 'trusted_v1' AND w.runtimeOwnerVersion = ?
+				AND s.runtimeOwner = 'trusted_v1' AND s.runtimeOwnerVersion = w.runtimeOwnerVersion
+				AND s.userId = w.userId AND s.projectId = w.projectId AND s.status = 'active' AND p.status != 'deleting'
+				AND w.startupDeadline > ? AND w.status NOT IN ('complete', 'failed', 'canceled')
+				AND w.expectedIdentityId = ? AND w.startupRoles = '["trusted_brain"]'
+				AND w.startupPools = '["brain"]' AND c.kind = 'prompt'
+			LIMIT 1`)
+				.bind(
+					request.operationId,
+					source.workspaceSessionId,
+					source.userId,
+					source.projectId,
+					source.ownerVersion,
+					now,
+					source.identityId,
+				)
+				.first();
+		if (!intent) throw new TransportDenied("startup_intent");
+		return;
+	}
+	const operation =
+		await env.DB.prepare(`SELECT o.id FROM privileged_operations o
+		JOIN sandbox_identities i ON i.id = o.identityId
+		JOIN workspace_sessions s ON s.id = i.workspaceSessionId
+		JOIN projects p ON p.id = i.projectId AND p.userId = i.userId
+		WHERE o.id = ? AND o.identityId = ? AND o.family = 'ditto_action' AND o.type = 'brain_transport'
+			AND o.contractVersion = 1 AND o.closedAt IS NULL AND o.expiresAt > ?
+			AND o.lifecycleGeneration = ? AND o.incarnationId = ? AND o.runtimeOwnerVersion = ?
+			AND o.runId = ? AND o.runEpoch = ?
+			AND EXISTS (SELECT 1 FROM runtime_command_memberships m
+				JOIN session_commands c ON c.id = m.commandId
+				WHERE m.commandId = o.admissionReference AND m.sessionId = s.id
+					AND m.runId = o.runId AND m.runEpoch = o.runEpoch
+					AND c.sessionId = s.id AND c.userId = i.userId AND c.projectId = i.projectId)
+			AND i.containerId = ? AND i.retiredAt IS NULL AND i.state NOT IN ('destroyed', 'destroying')
+			AND i.incarnationId = o.incarnationId AND i.lifecycleGeneration = o.lifecycleGeneration
+			AND s.brainIdentityId = i.id AND s.userId = i.userId AND s.projectId = i.projectId
+			AND s.status = 'active' AND s.runtimeOwner = 'trusted_v1' AND s.runtimeOwnerVersion = o.runtimeOwnerVersion
+			AND p.status != 'deleting'
+			AND NOT EXISTS (SELECT 1 FROM runtime_deleted_target_fences f WHERE
+				(f.targetKind = 'project' AND f.targetId = i.projectId) OR
+				(f.targetKind = 'workspace_session' AND f.targetId = i.workspaceSessionId))
+		LIMIT 1`)
+			.bind(
+				request.operationId,
+				source.identityId,
+				Math.floor(now / 1000),
+				source.lifecycleGeneration,
+				source.incarnation,
+				source.ownerVersion,
+				request.runId,
+				request.runEpoch,
+				source.containerId,
+			)
+			.first();
+	if (!operation) throw new TransportDenied("operation_authority");
+}
+
+export async function handleRuntimeOutbound(
+	request: Request,
+	env: RuntimeEgressEnv,
+	ctx: PlatformOutboundContext,
+	dispatch: BrainDispatch,
+	fetchImpl: typeof fetch = (input, init) => globalThis.fetch(input, init),
+): Promise<Response> {
+	try {
+		const source = await resolveRuntimeSource(env, ctx);
+		const url = new URL(request.url);
+		if (url.hostname === "ditto.internal") {
+			if (source.kind !== "trusted_brain")
+				throw new TransportDenied("brain_role");
+			const parsed = await parseBrainRequest(request, Date.now());
+			await authorizeBrainRequest(env, source, parsed, Date.now());
+			return Response.json(await dispatch(source, parsed));
+		}
+		if (
+			classifyOpenCodeRequest(request).kind !== "other" ||
+			classifyGithubGitRequest(request).kind !== "other" ||
+			classifyDittoActionRequest(request).kind !== "other" ||
+			isDittoSyntheticHost(url.hostname)
+		) {
+			throw new TransportDenied("privileged_transport_unavailable");
+		}
+		if (source.kind === "trusted_brain")
+			throw new TransportDenied("brain_egress");
+		return await handlePublicInternet(request, fetchImpl);
+	} catch (error) {
+		return transportDenial(
+			error instanceof TransportDenied ? error.code : "transport_denied",
+		);
+	}
+}
diff --git a/apps/web/src/lib/runtime-binding-graph.test.ts b/apps/web/src/lib/runtime-binding-graph.test.ts
