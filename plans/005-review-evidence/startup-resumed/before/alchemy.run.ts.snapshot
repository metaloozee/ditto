import alchemy from "alchemy";
import {
	Container,
	D1Database,
	R2Bucket,
	Route,
	TanStackStart,
	Worker,
	WorkerRef,
} from "alchemy/cloudflare";
import { config } from "dotenv";

config({ path: [".env.local", ".env"] });

const app = await alchemy("ditto");

async function createLocalTarget() {
	const runtimeServiceName = `${app.name}-${app.stage}-runtime-local`;
	const productServiceName = `${app.name}-${app.stage}-product-bridge-local`;
	const runtimeRef = WorkerRef({ service: runtimeServiceName });
	const productRef = WorkerRef({ service: productServiceName });
	const brainContainer = await Container("local-session-brain", {
		className: "SessionRuntime",
		build: {
			context: ".",
			dockerfile: "packages/session-brain/Dockerfile",
		},
		instanceType: "basic",
		maxInstances: 20,
	});
	const runtimeSandbox = await Container("local-runtime-sandbox", {
		className: "Sandbox",
		build: { context: ".", dockerfile: "Dockerfile" },
		instanceType: "basic",
		maxInstances: 20,
	});
	const product = await Worker("local-product-bridge", {
		name: productServiceName,
		entrypoint: "apps/web/src/lib/runtime-product-worker.ts",
		bindings: {
			DB: database,
			RUNTIME_CONTROLLER_NAMESPACE: runtimeServiceName,
			RUNTIME: Worker.experimentalEntrypoint(runtimeRef, "RuntimeEntrypoint"),
			BETTER_AUTH_SECRET: alchemy.secret("local-fixture-not-a-credential"),
			GITHUB_APP_ID: "",
			GITHUB_APP_PRIVATE_KEY: alchemy.secret(""),
		},
	});
	const runtime = await Worker("local-session-runtime", {
		name: runtimeServiceName,
		entrypoint: "apps/runtime/src/server.ts",
		bindings: {
			DB: database,
			BACKUP_BUCKET: sandboxBackups,
			SessionRuntime: brainContainer,
			Sandbox: runtimeSandbox,
			PRODUCT: Worker.experimentalEntrypoint(productRef, "ProductEntrypoint"),
			OPENCODE_API_KEY: alchemy.secret(""),
			RUNTIME_CONTROLLER_NAMESPACE: runtimeServiceName,
			RUNTIME_ENCRYPTION_CURRENT_KEY_VERSION: "v1",
			RUNTIME_ENCRYPTION_KEYS: alchemy.secret(
				JSON.stringify({ v1: "01".repeat(32) }),
			),
		},
	});
	return { product, runtime };
}

const sandbox = await Container("sandbox", {
	className: "Sandbox",
	build: {
		context: ".",
		dockerfile: "Dockerfile",
	},
	instanceType: "basic",
	maxInstances: 20,
});

const database = await D1Database("database", {
	name: `${app.name}-${app.stage}-db`,
	migrationsDir: "./apps/web/migrations",
	migrationsTable: "drizzle_migrations",
});

const sandboxBackups = await R2Bucket("sandbox-backups", {
	name: `${app.name}-${app.stage}-sandbox-backups`,
});

export const localTarget =
	app.local && process.env.DITTO_LOCAL_RUNTIME_TOPOLOGY === "1"
		? await createLocalTarget()
		: null;

export type LocalProductEnv = NonNullable<typeof localTarget>["product"]["Env"];
export type LocalRuntimeEnv = NonNullable<typeof localTarget>["runtime"]["Env"];

export const website = await TanStackStart("website", {
	cwd: "apps/web",
	url: true,
	crons: ["* * * * *"],
	bindings: {
		DB: database,
		Sandbox: sandbox,
		BACKUP_BUCKET: sandboxBackups,
		CLOUDFLARE_ACCOUNT_ID: process.env.CLOUDFLARE_ACCOUNT_ID ?? "",
		BETTER_AUTH_SECRET: alchemy.secret(process.env.BETTER_AUTH_SECRET),
		BETTER_AUTH_URL: process.env.BETTER_AUTH_URL ?? "",
		GITHUB_CLIENT_ID: process.env.GITHUB_CLIENT_ID ?? "",
		GITHUB_CLIENT_SECRET: alchemy.secret(process.env.GITHUB_CLIENT_SECRET),
		GITHUB_APP_ID: process.env.GITHUB_APP_ID ?? "",
		GITHUB_APP_PRIVATE_KEY: alchemy.secret(process.env.GITHUB_APP_PRIVATE_KEY),
		VITE_GITHUB_APP_INSTALL_URL:
			process.env.VITE_GITHUB_APP_INSTALL_URL ??
			"https://github.com/apps/ditto-web/installations/new/",
		OPENCODE_API_KEY: alchemy.secret(process.env.OPENCODE_API_KEY),
		SANDBOX_TRANSPORT: "rpc",
		PREVIEW_BASE_HOST: "ayn.wtf",
	},
	wrangler: {
		main: "src/server.ts",
		transform: (spec) => ({
			...spec,
			d1_databases: spec.d1_databases?.map((database) =>
				database.binding === "DB"
					? { ...database, migrations_dir: "../../migrations" }
					: database,
			),
			containers: [
				{
					class_name: "Sandbox",
					image: "../../../../Dockerfile",
					instance_type: "basic",
					max_instances: 20,
				},
			],
			durable_objects: {
				...spec.durable_objects,
				bindings: [
					{
						class_name: "Sandbox",
						name: "Sandbox",
					},
				],
			},
			migrations: [{ new_sqlite_classes: ["Sandbox"], tag: "v1" }],
		}),
	},
});

await Route("session-previews", {
	pattern: "*.ayn.wtf/*",
	script: website,
	adopt: true,
	dev: true,
});

console.log({ url: website.url });

await app.finalize();
