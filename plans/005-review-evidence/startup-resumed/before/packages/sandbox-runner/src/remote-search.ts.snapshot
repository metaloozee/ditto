import { spawn } from "node:child_process";
import path from "node:path";
import type { RemoteArguments } from "@ditto/runtime-contracts";
import { truncateHead, truncateLine } from "@earendil-works/pi-coding-agent";
import type { RemoteToolResult } from "./remote-tool.js";

// Default Rust regex engine only. No PATH lookup, PCRE2, config file or downloads.
export const SEARCH_EXECUTABLE = "/usr/bin/rg";
const RECORD_BYTES = 2 * 1024 * 1024;
const SEARCH_OUTPUT_BYTES = 50 * 1024;

type Match = { file: string; line: number; text: string };
function recordMatch(line: string): Match | null {
	const event: unknown = JSON.parse(line);
	if (
		!event ||
		typeof event !== "object" ||
		!("type" in event) ||
		event.type !== "match" ||
		!("data" in event) ||
		!event.data ||
		typeof event.data !== "object"
	)
		return null;
	const data = event.data;
	if (
		!("path" in data) ||
		!data.path ||
		typeof data.path !== "object" ||
		!("text" in data.path) ||
		typeof data.path.text !== "string" ||
		!("line_number" in data) ||
		typeof data.line_number !== "number" ||
		!("lines" in data) ||
		!data.lines ||
		typeof data.lines !== "object" ||
		!("text" in data.lines) ||
		typeof data.lines.text !== "string"
	)
		return null;
	return {
		file: data.path.text,
		line: data.line_number,
		text: data.lines.text,
	};
}

async function runSearch(
	args: string[],
	root: string,
	signal: AbortSignal,
	onLine: (line: string) => boolean,
): Promise<void> {
	if (signal.aborted) throw new Error("canceled");
	await new Promise<void>((resolve, reject) => {
		const child = spawn(SEARCH_EXECUTABLE, ["--no-config", ...args], {
			cwd: root,
			env: {
				PATH: "/usr/bin:/bin",
				HOME: "/tmp",
				LANG: "C.UTF-8",
				LC_ALL: "C.UTF-8",
			},
			stdio: ["ignore", "pipe", "pipe"],
		});
		let buffer = "";
		let stopped = false;
		let failure: Error | undefined;
		const stop = () => {
			stopped = true;
			child.kill("SIGKILL");
		};
		const abort = () => {
			failure = new Error("canceled");
			stop();
		};
		signal.addEventListener("abort", abort, { once: true });
		child.stdout.on("data", (chunk: Buffer) => {
			if (stopped) return;
			buffer += chunk.toString("utf8");
			if (Buffer.byteLength(buffer) > RECORD_BYTES) {
				failure = new Error("search_record_limit");
				stop();
				return;
			}
			let newline = buffer.indexOf("\n");
			try {
				while (newline >= 0 && !stopped) {
					const line = buffer.slice(0, newline);
					buffer = buffer.slice(newline + 1);
					if (!onLine(line)) stop();
					newline = buffer.indexOf("\n");
				}
			} catch {
				failure = new Error("search_protocol");
				stop();
			}
		});
		// Never include repository-controlled stderr in protocol errors.
		child.stderr.on("data", () => undefined);
		child.once("error", () => {
			failure = new Error("search_unavailable");
		});
		child.once("close", (code) => {
			signal.removeEventListener("abort", abort);
			if (failure) reject(failure);
			else if (!stopped && code !== 0 && code !== 1)
				reject(new Error("search_pattern"));
			else resolve();
		});
		if (signal.aborted) abort();
	});
}

export async function remoteSearch(
	tool: Extract<RemoteArguments, { name: "grep" | "find" }>,
	root: string,
	target: string,
	directory: boolean,
	signal: AbortSignal,
	read: (file: string) => Promise<string>,
): Promise<RemoteToolResult> {
	const limit = tool.limit ?? (tool.name === "grep" ? 100 : 1000);
	const common = [
		"--color=never",
		"--hidden",
		"--sort=path",
		"--no-ignore-global",
		"--max-filesize=1M",
	];
	const lines: string[] = [];
	let limited = false;
	let linesTruncated = false;
	if (tool.name === "find") {
		await runSearch(
			[...common, "--files", "--glob", tool.pattern, "--", target],
			root,
			signal,
			(line) => {
				lines.push(path.relative(target, line));
				if (lines.length >= limit) {
					limited = true;
					return false;
				}
				return true;
			},
		);
	} else {
		const matches: Match[] = [];
		const args = [...common, "--json", "--line-number"];
		if (tool.ignoreCase) args.push("--ignore-case");
		if (tool.literal) args.push("--fixed-strings");
		if (tool.glob) args.push("--glob", tool.glob);
		await runSearch(
			[...args, "--", tool.pattern, target],
			root,
			signal,
			(line) => {
				const match = recordMatch(line);
				if (match) matches.push(match);
				if (matches.length >= limit) {
					limited = true;
					return false;
				}
				return true;
			},
		);
		const formatPath = (file: string) =>
			directory ? path.relative(target, file) : path.basename(file);
		const cache = new Map<string, string[]>();
		const format = (text: string) => {
			const truncated = truncateLine(text.replace(/\r/g, ""));
			linesTruncated ||= truncated.wasTruncated;
			return truncated.text;
		};
		for (const match of matches) {
			if (signal.aborted) throw new Error("canceled");
			const file = formatPath(match.file);
			if (!tool.context)
				lines.push(
					`${file}:${match.line}: ${format(match.text.replace(/\r\n/g, "\n").replace(/\n$/, ""))}`,
				);
			else {
				let content = cache.get(match.file);
				if (!content) {
					try {
						content = (await read(match.file))
							.replace(/\r\n/g, "\n")
							.replace(/\r/g, "\n")
							.split("\n");
					} catch {
						content = [];
					}
					cache.set(match.file, content);
				}
				if (!content.length)
					lines.push(`${file}:${match.line}: (unable to read file)`);
				for (
					let n = Math.max(1, match.line - tool.context);
					n <= Math.min(content.length, match.line + tool.context);
					n++
				)
					lines.push(
						n === match.line
							? `${file}:${n}: ${format(content[n - 1])}`
							: `${file}-${n}- ${format(content[n - 1])}`,
					);
			}
			if (Buffer.byteLength(lines.join("\n")) > SEARCH_OUTPUT_BYTES) break;
		}
	}
	if (!lines.length)
		return {
			content: [
				{
					type: "text",
					text:
						tool.name === "grep"
							? "No matches found"
							: "No files found matching pattern",
				},
			],
		};
	const truncation = truncateHead(lines.join("\n"), {
		maxLines: Number.MAX_SAFE_INTEGER,
		maxBytes: SEARCH_OUTPUT_BYTES,
	});
	const details: Record<string, unknown> = {};
	const notices: string[] = [];
	if (limited) {
		details[tool.name === "grep" ? "matchLimitReached" : "resultLimitReached"] =
			limit;
		notices.push(
			`${limit} ${tool.name === "grep" ? "matches" : "results"} limit reached`,
		);
	}
	if (truncation.truncated) {
		details.truncation = truncation;
		notices.push("50KB limit reached");
	}
	if (linesTruncated) {
		details.linesTruncated = true;
		notices.push(
			"Some lines truncated to 500 chars. Use read tool to see full lines",
		);
	}
	return {
		content: [
			{
				type: "text",
				text:
					truncation.content +
					(notices.length ? `\n\n[${notices.join(". ")}]` : ""),
			},
		],
		details,
	};
}
