ALTER TABLE project_seeds ADD startupUserId text;
--> statement-breakpoint
ALTER TABLE runtime_migrations ADD startupUserId text;
--> statement-breakpoint
CREATE TABLE runtime_startup_assignments (
 sourceKind text NOT NULL CHECK(sourceKind IN ('command','builder','migration')),
 sourceId text NOT NULL,
 role text NOT NULL CHECK(role IN ('trusted_brain','workspace_session','project_seed')),
 identityId text NOT NULL,
 incarnationId text NOT NULL,
 lifecycleGeneration integer NOT NULL CHECK(lifecycleGeneration > 0),
 ownerVersion integer NOT NULL CHECK(ownerVersion > 0),
 controllerNamespace text NOT NULL,
 state text NOT NULL CHECK(state IN ('assigned','retired')),
 PRIMARY KEY(sourceKind, sourceId, role)
);
--> statement-breakpoint
CREATE UNIQUE INDEX runtime_startup_assignments_source_role_uidx ON runtime_startup_assignments(sourceKind,sourceId,role);
--> statement-breakpoint
CREATE TABLE runtime_identity_transitions (
 id text PRIMARY KEY NOT NULL,
 sourceKind text NOT NULL CHECK(sourceKind IN ('recovery','lifecycle','migration','deletion')),
 sourceId text NOT NULL,
 action text NOT NULL CHECK(action IN ('rotate','retire')),
 identityId text NOT NULL,
 userId text NOT NULL,
 projectId text NOT NULL,
 sessionId text,
 expectedOwner text NOT NULL,
 ownerVersion integer NOT NULL,
 lifecycleGeneration integer NOT NULL,
 incarnationId text NOT NULL,
 deadline integer NOT NULL,
 state text NOT NULL CHECK(state IN ('approved','complete')),
 replacementIncarnationId text,
 completionToken text,
 completedAt integer
);
--> statement-breakpoint
CREATE VIEW runtime_startup_sources AS
 SELECT 'command' AS sourceKind, w.id AS sourceId, w.userId, w.projectId, w.sessionId,
 w.runtimeOwner AS expectedOwner, w.runtimeOwnerVersion AS ownerVersion,
 w.startupRoles AS roles, w.startupPools AS pools, w.startupDeadline AS deadline,
 s.brainIdentityId, s.sandboxIdentityId, NULL AS builderIdentityId
 FROM workspace_runtime_work w
 JOIN session_commands c ON c.id = w.commandId AND c.sessionId = w.sessionId AND c.userId = w.userId AND c.projectId = w.projectId
 JOIN workspace_sessions s ON s.id = w.sessionId AND s.userId = w.userId AND s.projectId = w.projectId
 JOIN projects p ON p.id = w.projectId AND p.userId = w.userId
 WHERE c.kind = 'prompt' AND w.intent = 'agent_run' AND w.runtimeOwner = 'trusted_v1'
 AND s.runtimeOwner = w.runtimeOwner AND s.runtimeOwnerVersion = w.runtimeOwnerVersion AND s.status = 'active'
 AND w.status IN ('queued','leased','running') AND w.startupRoles = '["trusted_brain","workspace_session"]' AND w.startupPools = '["brain","execution"]'
 AND p.status != 'deleting' AND NOT EXISTS (SELECT 1 FROM runtime_deleted_target_fences f WHERE
 (f.targetKind = 'project' AND f.targetId = p.id) OR (f.targetKind = 'workspace_session' AND f.targetId = s.id))
 UNION ALL
 SELECT 'builder', b.id, b.startupUserId, b.projectId, NULL, 'trusted_v1', b.expectedRuntimeOwnerVersion,
 b.startupRoles, b.startupPools, b.startupDeadline, NULL, NULL, b.expectedIdentityId
 FROM project_seeds b JOIN projects p ON p.id = b.projectId AND p.userId = b.startupUserId
 WHERE b.buildState = 'pending' AND b.expectedRuntimeOwnerVersion = 1
 AND b.startupRoles = '["project_seed"]' AND b.startupPools = '["execution"]'
 AND p.status != 'deleting' AND NOT EXISTS (SELECT 1 FROM runtime_deleted_target_fences f WHERE f.targetKind = 'project' AND f.targetId = p.id)
 UNION ALL
 SELECT 'migration', m.id, m.startupUserId, s.projectId, s.id, m.expectedOwner, m.expectedOwnerVersion,
 m.startupRoles, m.startupPools, m.startupDeadline, s.brainIdentityId, s.sandboxIdentityId, NULL
 FROM runtime_migrations m JOIN workspace_sessions s ON s.id = m.sessionId AND s.userId = m.startupUserId
 JOIN projects p ON p.id = s.projectId AND p.userId = m.startupUserId
 WHERE m.state = 'pending' AND m.expectedOwner = 'migrating' AND s.runtimeOwner = m.expectedOwner AND s.runtimeOwnerVersion = m.expectedOwnerVersion
 AND s.status = 'active' AND p.status != 'deleting'
 AND m.startupRoles = '["trusted_brain","workspace_session"]' AND m.startupPools = '["brain","execution"]'
 AND NOT EXISTS (SELECT 1 FROM runtime_deleted_target_fences f WHERE
 (f.targetKind = 'project' AND f.targetId = p.id) OR (f.targetKind = 'workspace_session' AND f.targetId = s.id));
