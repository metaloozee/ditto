import { readFileSync } from "node:fs";
import { afterEach, describe, expect, it, vi } from "vitest";
import { authorizeBrainRequest, resolveRuntimeSource } from "../../../runtime/src/runtime-egress";
import type { BrainRequest } from "../../../runtime/src/brain-transport";
import type { IdentityTransitionReference, StartupAssignment, StartupReference } from "../../../runtime/src/startup-contract";
import { RuntimeEntrypoint, Sandbox, SessionRuntime } from "../../../runtime/src/server";
import { createSessionRuntimeFixture, type SessionRuntimeFixture } from "../test/session-runtime-fixture";
import { ProductEntrypoint } from "./session-runtime-product";
import { handleSessionCommandRequest } from "./session-command";
import { createSqliteD1 } from "./sqlite-d1-test-utils";

vi.mock("cloudflare:workers", () => ({
 env: {}, DurableObject: class {}, WorkerEntrypoint: class { constructor(readonly ctx: unknown, readonly env: unknown) {} },
}));
vi.mock("@cloudflare/containers", () => ({ Container: class {}, ContainerProxy: class {} }));
vi.mock("@cloudflare/sandbox", () => ({ Sandbox: class {}, getSandbox: vi.fn() }));
const fixtures: SessionRuntimeFixture[] = [];
afterEach(() => { fixtures.splice(0).forEach(f => f.dispose()); vi.restoreAllMocks(); });
const migration = readFileSync(new URL("../../migrations/0022_runtime_startup_assignments.sql",import.meta.url),"utf8").replaceAll("--> statement-breakpoint", "");
const priorMigration = readFileSync(new URL("../../migrations/0020_trusted_runtime_additive.sql",import.meta.url),"utf8");

async function setup() {
 const f = createSessionRuntimeFixture(); fixtures.push(f); f.seedTrustedSession();
 f.sqlite.exec(`DELETE FROM sandbox_identities; DELETE FROM workspace_capacity_leases;
 UPDATE workspace_sessions SET brainIdentityId = NULL, sandboxIdentityId = NULL;
 CREATE TABLE project_seeds (id text PRIMARY KEY,projectId text,buildState text,startupRoles text,startupPools text,expectedRuntimeOwnerVersion integer,expectedIdentityId text,startupDeadline integer);
 CREATE TABLE privileged_operations (id text PRIMARY KEY,identityId text,closedAt integer,closeReason text,openSlot text);
 CREATE TABLE runtime_retired_identity_fences (identityId text PRIMARY KEY,lifecycleGeneration integer,retiredAt integer);`);
 for (const table of ["runtime_capacity_reservations","runtime_migrations"]) {
  const sql = priorMigration.split("--> statement-breakpoint").find(s => s.trimStart().startsWith(`CREATE TABLE \`${table}\``));
  if (!sql) throw new Error("fixture_schema"); f.sqlite.exec(sql);
 }
 f.sqlite.exec(`CREATE UNIQUE INDEX runtime_capacity_reservations_identity_pool_active_uidx ON runtime_capacity_reservations(identityId,pool,activeSlot);`);
 f.sqlite.exec(migration);
 let now = Date.now();
 const launches = new Map<string, { assignment: StartupAssignment; running: boolean }>();
 const brainNamespace = {
  idFromName: (name: string) => ({ toString: () => `brain:${name}` }),
  idFromString: (id: string) => ({ toString: () => id }),
  get(id: { toString(): string }) { return observer(id.toString(), SessionRuntime.prototype, "SessionRuntime"); },
 };
 const sandboxNamespace = {
  idFromName: (name: string) => ({ toString: () => `execution:${name}` }),
  idFromString: (id: string) => ({ toString: () => id }),
  get(id: { toString(): string }) { return observer(id.toString(), Sandbox.prototype, "Sandbox"); },
 };
 function observer(id: string, prototype: object, controllerClass: "SessionRuntime" | "Sandbox") {
  const value = Object.create(prototype);
  Object.assign(value, { env: {RUNTIME_CONTROLLER_NAMESPACE: "runtime"}, ctx: {
   id: {toString: () => id}, storage: { get: async () => {
    const launch = launches.get(id)?.assignment;
    return launch ? {identityId: launch.identityId,incarnationId: launch.incarnationId,lifecycleGeneration: launch.lifecycleGeneration,containerId: id,controllerClass,controllerNamespace: "runtime"} : undefined;
   } }, container: {get running() { return launches.get(id)?.running; }},
  } });
  return value as {observeStartup: RuntimeEntrypoint["observeStartup"]};
 }
 const runtime = Object.create(RuntimeEntrypoint.prototype) as RuntimeEntrypoint;
 const db = createSqliteD1(f.sqlite);
 const runtimeEnv = {DB: db, RUNTIME_CONTROLLER_NAMESPACE: "runtime", SessionRuntime: brainNamespace, Sandbox: sandboxNamespace, PRODUCT: {} };
 Object.assign(runtime, { env: runtimeEnv });
 const product = new ProductEntrypoint({} as ExecutionContext,{DB: db, RUNTIME_CONTROLLER_NAMESPACE: "runtime", RUNTIME: {
  startupRouting: input => runtime.startupRouting(input), observeStartup: input => runtime.observeStartup(input), currentExecution: async () => false,
 } });
 runtimeEnv.PRODUCT = product;
 const admission = await handleSessionCommandRequest({ db: f.db, runtime: f.runtime, authenticatedUserId: "user-1", body: {
  version:1,kind:"prompt",projectId:"proj-1",sessionId:"sess-1",idempotencyKey:"startup",text:"hello",
 } });
 expect(admission.status).toBe(202);
 const work = f.sqlite.prepare("SELECT id FROM workspace_runtime_work").get() as {id:string};
 const ref: StartupReference = {sourceKind:"command",sourceId:work.id};
 const effects = () => ({identities:f.sqlite.prepare("SELECT * FROM sandbox_identities ORDER BY id").all(), assignments:f.sqlite.prepare("SELECT * FROM runtime_startup_assignments ORDER BY sourceId,role").all(), reservations:f.sqlite.prepare("SELECT * FROM runtime_capacity_reservations ORDER BY id").all(), operations:f.sqlite.prepare("SELECT * FROM privileged_operations ORDER BY id").all()});
 const unified = () => f.sqlite.exec("UPDATE runtime_capacity_policy SET accountingMode = 'unified'");
 const pair = async () => { unified(); return runtime.prepareStartup(ref); };
 return {f,ref,product,runtime,runtimeEnv,db,launches,now:()=>now,setNow:(value:number)=>{now=value;},effects,unified,pair};
}

function transition(s: Awaited<ReturnType<typeof setup>>, a: StartupAssignment, action: "rotate" | "retire", kind = "lifecycle"): IdentityTransitionReference {
 const id = crypto.randomUUID();
 s.f.sqlite.prepare(`INSERT INTO runtime_identity_transitions (id,sourceKind,sourceId,action,identityId,userId,projectId,sessionId,expectedOwner,ownerVersion,lifecycleGeneration,incarnationId,deadline,state) VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,'approved')`)
 .run(id,kind,"approved-policy-fixture",action,a.identityId,a.userId,a.projectId,a.sessionId,"trusted_v1",a.ownerVersion,a.lifecycleGeneration,a.incarnationId,Date.now()+60_000);
 return {transitionId:id,identityId:a.identityId,incarnationId:a.incarnationId,ownerVersion:a.ownerVersion,lifecycleGeneration:a.lifecycleGeneration};
}

describe("R2 actual product and runtime named methods, SQLite writes, platform DI only", () => {
 it("accepted command -> durable pair assignment -> atomic reservations -> readiness before any window", async () => {
  const s = await setup();
  const work = s.f.sqlite.prepare("SELECT * FROM workspace_runtime_work").get();
  expect(work).toMatchObject({startupRoles:'["trusted_brain","workspace_session"]',startupPools:'["brain","execution"]',runtimeOwnerVersion:1});
  const result = await s.pair(); expect(result.assignments).toHaveLength(2); expect(result.reservations).toHaveLength(2);
  expect(s.effects().operations).toEqual([]);
  const a = result.assignments.find(a=>a.role === "trusted_brain")!;
  const env = {DB:s.db,RUNTIME_CONTROLLER_NAMESPACE:"runtime"};
  const source = await resolveRuntimeSource(env,{containerId:a.containerId,className:a.controllerClass,params:{incarnation:a.incarnationId,lifecycleGeneration:a.lifecycleGeneration}});
  const request: BrainRequest = {version:1,kind:"readiness",operationId:s.ref.sourceId,brainIdentityId:a.identityId,brainIncarnationId:a.incarnationId,ownerVersion:a.ownerVersion,lifecycleGeneration:a.lifecycleGeneration,runId:"startup",runEpoch:1,attempt:1,expectedCommittedPosition:0,payload:{},deadline:Date.now()+30_000};
  expect(await authorizeBrainRequest(env,source,request,Date.now())).toBeGreaterThan(Date.now());
  const before = s.effects(); expect(await s.runtime.prepareStartup(s.ref)).toEqual(result); expect(s.effects()).toEqual(before);
  expect(await s.product.readExecutionPrerequisites({workspaceSessionId:"sess-1",projectId:"proj-1",userId:"user-1"})).toBeNull();
 });
 it("production legacy accounting stays closed and never partially reserves",async()=>{
  const s=await setup(); await s.product.registerStartup({...s.ref,role:"trusted_brain"}); await s.product.registerStartup({...s.ref,role:"workspace_session"});
  await expect(s.product.reserveStartup(s.ref)).rejects.toThrow("capacity_denied"); expect(s.effects().reservations).toEqual([]);
  expect(s.f.sqlite.prepare("SELECT accountingMode FROM runtime_capacity_policy").get()).toEqual({accountingMode:"legacy"});
 });
 it.each(["fabricated","expired","foreign","superseded","deleted","role","pool","bodyIdentity"])("%s startup references cannot create or enlarge authority",async(mode)=>{
  const s=await setup(); const ref={...s.ref};
  if(mode==="fabricated") ref.sourceId="fabricated";
  if(mode==="expired") s.f.sqlite.exec("UPDATE workspace_runtime_work SET startupDeadline = 1");
  if(mode==="foreign") s.f.sqlite.exec("UPDATE workspace_runtime_work SET sessionId = 'other'");
  if(mode==="superseded") s.f.sqlite.exec("UPDATE workspace_sessions SET runtimeOwnerVersion = 2");
  if(mode==="deleted") s.f.sqlite.exec("UPDATE projects SET status = 'deleting'");
  if(mode==="pool") s.f.sqlite.exec(`UPDATE workspace_runtime_work SET startupPools = '["brain","execution","extra"]'`);
  const input={...ref,role:mode==="role" ? "project_seed" as const : "trusted_brain" as const};
  const before=s.effects();
  const request = mode==="bodyIdentity"?{...input,identityId:"caller"}:input;
  await expect(s.product.registerStartup(request)).rejects.toThrow("startup_denied");
  expect(s.effects()).toEqual(before);
 });
 it("routing await and write-time deletion rechecks leave no assignment or identity",async()=>{
  const s=await setup();
  const original=s.runtime.startupRouting.bind(s.runtime);
  vi.spyOn(s.runtime,"startupRouting").mockImplementation(async input=>{const route=await original(input);s.f.sqlite.exec("UPDATE projects SET status = 'deleting'");return route;});
  await expect(s.product.registerStartup({...s.ref,role:"trusted_brain"})).rejects.toThrow("startup_denied"); expect(s.effects().identities).toEqual([]); expect(s.effects().assignments).toEqual([]);
 });
 it.each(["controllerClass","controllerNamespace","incarnationId","retiredAt","link"])("conflicting retry %s has no effects",async(field)=>{
  const s=await setup(); const a=await s.product.registerStartup({...s.ref,role:"trusted_brain"});
  if(field==="link") s.f.sqlite.exec("UPDATE workspace_sessions SET brainIdentityId = 'different'");
  else s.f.sqlite.prepare(`UPDATE sandbox_identities SET ${field} = ? WHERE id = ?`).run(field==="retiredAt"?1:"different",a.identityId);
  const before=s.effects();await expect(s.product.registerStartup({...s.ref,role:"trusted_brain"})).rejects.toThrow("startup_denied");expect(s.effects()).toEqual(before);
 });
 it("overlapping identical registration uses one random identity and incarnation",async()=>{
  const s=await setup();const [a,b]=await Promise.all([s.product.registerStartup({...s.ref,role:"trusted_brain"}),s.product.registerStartup({...s.ref,role:"trusted_brain"})]);
  expect(a).toEqual(b);expect(s.effects().identities).toHaveLength(1);
 });
 it("an occupied execution pool denies the whole pair, without a brain-only claim",async()=>{
  const s=await setup();s.unified();await s.product.registerStartup({...s.ref,role:"trusted_brain"});await s.product.registerStartup({...s.ref,role:"workspace_session"});
  for(let n=0;n<2;n++) s.f.sqlite.prepare(`INSERT INTO runtime_capacity_reservations VALUES (?,'execution','workspace_session',?,'user-1',NULL,?,?,'other','running',1,1,1,'active',0,0)`).run(`r${n}`,`s${n}`,`i${n}`,`inc${n}`);
  const before=s.effects();await expect(s.product.reserveStartup(s.ref)).rejects.toThrow("capacity_denied");expect(s.effects()).toEqual(before);
 });
 it("body pool lists and stale incarnation reservations are denied without writes",async()=>{
  const s=await setup();const result=await s.pair();const before=s.effects();
  const expanded = {...s.ref,requiredPools:["brain","execution"]};
  await expect(s.product.reserveStartup(expanded)).rejects.toThrow("startup_denied");
  const r=result.reservations[0];await expect(s.product.observeCapacity({...r,incarnationId:"stale"})).rejects.toThrow("capacity_denied");expect(s.effects()).toEqual(before);
 });
 it("trusted launch observation works; expiry and isolation do not free running slots, termination does",async()=>{
  const s=await setup();const result=await s.pair();const a=result.assignments[0],r=result.reservations.find(r=>r.identityId===a.identityId)!;
  s.launches.set(a.containerId,{assignment:a,running:true});await s.product.observeCapacity(r);
  s.f.sqlite.exec("UPDATE runtime_capacity_reservations SET expiresAt = 1; UPDATE workspace_runtime_work SET startupDeadline = 1");
  const before=s.effects();await expect(s.product.releaseCapacity(r)).rejects.toThrow("capacity_denied");expect(s.effects()).toEqual(before);
  const observe=vi.spyOn(s.runtime,"observeStartup").mockResolvedValue({...a,state:"isolated"});
  await expect(s.product.releaseCapacity(r)).rejects.toThrow("capacity_denied");expect(s.effects()).toEqual(before);observe.mockRestore();
  s.launches.set(a.containerId,{assignment:a,running:false});await s.product.releaseCapacity(r);await s.product.releaseCapacity(r);
  expect(s.f.sqlite.prepare("SELECT observedState, activeSlot FROM runtime_capacity_reservations WHERE id = ?").get(r.reservationId)).toEqual({observedState:"released",activeSlot:r.reservationId});
 });
 it.each(["identityId","incarnationId","lifecycleGeneration","containerId","controllerClass","controllerNamespace"])("platform evidence mismatch %s cannot release",async(field)=>{
  const s=await setup();const result=await s.pair();const a=result.assignments[0],r=result.reservations[0];
  vi.spyOn(s.runtime,"observeStartup").mockResolvedValue({...a,state:"terminated",[field]:field==="lifecycleGeneration"?2:"wrong"});const before=s.effects();
  await expect(s.product.releaseCapacity(r)).rejects.toThrow("capacity_denied");expect(s.effects()).toEqual(before);
 });
 it("an unknown platform launch or changed owner during observation cannot free a slot",async()=>{
  const s=await setup();const result=await s.pair();const a=result.assignments[0],r=result.reservations.find(r=>r.identityId===a.identityId)!;
  await expect(s.product.releaseCapacity(r)).rejects.toThrow("capacity_denied");
  s.launches.set(a.containerId,{assignment:a,running:false});const original=s.runtime.observeStartup.bind(s.runtime);
  vi.spyOn(s.runtime,"observeStartup").mockImplementation(async input=>{const result=await original(input);s.f.sqlite.exec("UPDATE workspace_sessions SET runtimeOwnerVersion = 2");return result;});
  const before=s.effects();await expect(s.product.releaseCapacity(r)).rejects.toThrow("capacity_denied");expect(s.effects()).toEqual(before);
 });
 it("persisted builder authority permits only a seed Sandbox and execution pool, never a brain",async()=>{
  const s=await setup();s.unified();s.f.sqlite.prepare(`INSERT INTO project_seeds (id,projectId,buildState,startupRoles,startupPools,expectedRuntimeOwnerVersion,startupDeadline,startupUserId) VALUES ('seed','proj-1','pending','["project_seed"]','["execution"]',1,?,'user-1')`).run(Date.now()+60_000);
  const ref:StartupReference={sourceKind:"builder",sourceId:"seed"};const before=s.effects();await expect(s.product.registerStartup({...ref,role:"trusted_brain"})).rejects.toThrow("startup_denied");expect(s.effects()).toEqual(before);
  const result=await s.runtime.prepareStartup(ref);expect(result.assignments).toHaveLength(1);expect(result.assignments[0]).toMatchObject({role:"project_seed",controllerClass:"Sandbox",sessionId:null});expect(result.reservations).toHaveLength(1);expect(s.effects().operations).toEqual([]);
 });
 it("only an existing approved migration source registers; ownership switch invalidates callbacks",async()=>{
  const s=await setup();s.unified();s.f.sqlite.exec("UPDATE workspace_sessions SET runtimeOwner = 'migrating'");
  s.f.sqlite.prepare(`INSERT INTO runtime_migrations (id,sessionId,expectedOwner,expectedOwnerVersion,startupRoles,startupPools,startupDeadline,state,createdAt,startupUserId) VALUES ('migration','sess-1','migrating',1,'["trusted_brain","workspace_session"]','["brain","execution"]',?,'pending',0,'user-1')`).run(Date.now()+60_000);
  const ref:StartupReference={sourceKind:"migration",sourceId:"migration"};const result=await s.runtime.prepareStartup(ref);expect(result.reservations).toHaveLength(2);
  s.f.sqlite.exec("UPDATE workspace_sessions SET runtimeOwnerVersion = 2");const before=s.effects();await expect(s.product.registerStartup({...ref,role:"trusted_brain"})).rejects.toThrow("startup_denied");expect(s.effects()).toEqual(before);
 });
 it("approved retirement tombstones never reopen and occupied capacity stays until trusted termination",async()=>{
  const s=await setup();const result=await s.pair();const a=result.assignments[0],r=result.reservations.find(r=>r.identityId===a.identityId)!;
  await expect(s.product.retireIdentity({transitionId:"fabricated",identityId:a.identityId,incarnationId:a.incarnationId,ownerVersion:a.ownerVersion,lifecycleGeneration:a.lifecycleGeneration})).rejects.toThrow("identity_transition_denied");
  const ref=transition(s,a,"retire");await s.product.retireIdentity(ref);await s.product.retireIdentity(ref);
  expect(s.f.sqlite.prepare("SELECT identityId FROM runtime_retired_identity_fences").get()).toEqual({identityId:a.identityId});
  const before=s.effects();await expect(s.product.registerStartup({...s.ref,role:a.role})).rejects.toThrow("startup_denied");expect(s.effects()).toEqual(before);
  expect(s.effects().reservations.every(r=>r.activeSlot === "active")).toBe(true);
  s.launches.set(a.containerId,{assignment:a,running:false});await s.product.releaseCapacity(r);
 });
 it("rotation needs persisted exact authority and cannot resurrect retired IDs",async()=>{
  const s=await setup();const result=await s.pair();const a=result.assignments[0];const ref=transition(s,a,"rotate");const before=s.effects();
  await expect(s.product.rotateIdentity({...ref,incarnationId:"stale"})).rejects.toThrow("identity_transition_denied");expect(s.effects()).toEqual(before);
  s.launches.set(a.containerId,{assignment:a,running:false});
  const rotated=await s.product.rotateIdentity(ref);expect(rotated.replacementIncarnationId).not.toBe(a.incarnationId);
  expect(s.f.sqlite.prepare("SELECT lifecycleGeneration FROM sandbox_identities WHERE id = ?").get(a.identityId)).toEqual({lifecycleGeneration:2});
  expect(s.effects().reservations.every(r=>r.activeSlot === "active")).toBe(true);
 });
 it("deleting cleanup can retire from an approved deletion command, never rotate",async()=>{
  const s=await setup();const result=await s.pair();const a=result.assignments[0];const ref=transition(s,a,"retire","deletion");
  s.f.sqlite.exec("UPDATE projects SET status = 'deleting'");
  s.f.sqlite.prepare(`INSERT INTO session_commands (id,userId,targetKind,targetId,projectId,kind,payloadVersion,payloadDigest,acceptedAt,deadlineAt) VALUES ('deletion','user-1','project','proj-1','proj-1','project_delete',1,'d',0,9999999999999)`).run();
  s.f.sqlite.prepare("UPDATE runtime_identity_transitions SET sourceId = 'deletion' WHERE id = ?").run(ref.transitionId);
  await s.product.retireIdentity(ref);expect(s.effects().identities.find(i=>i.id===a.identityId)?.retiredAt).not.toBeNull();
  await expect(s.product.rotateIdentity(ref)).rejects.toThrow("identity_transition_denied");
 });
});
