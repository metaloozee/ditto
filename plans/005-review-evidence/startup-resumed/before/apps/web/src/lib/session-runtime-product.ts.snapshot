import { WorkerEntrypoint } from "cloudflare:workers";
import { createDb } from "#/db";
import { createProductAdapters } from "#/lib/session-runtime-authority";
import type { LocalProductEnv } from "../../../../alchemy.run";
import type { ExecutionEnvironmentReference } from "../../../runtime/src/executor-dispatch.js";
import type {
	ProjectionApplyResult,
	ProjectionPayload,
} from "../../../runtime/src/product-projector.js";
import type {
	CurrentAuthority,
	ReconstructedAdmission,
} from "../../../runtime/src/session-runtime.js";
import { executionEnvironment } from "./runtime-product-service.js";
import { createRuntimeStartupService } from "./runtime-startup-service.js";
import type { CapacityReference, IdentityTransitionReference, RegisterStartup, StartupReference, StartupRuntime } from "../../../runtime/src/startup-contract.js";

function productEnv(
	env: Pick<LocalProductEnv, "DB">,
): { DB: D1Database } | null {
	if (!env || typeof env !== "object" || !("DB" in env) || !env.DB) {
		return null;
	}
	return { DB: env.DB };
}

type ProductServiceEnv = Pick<LocalProductEnv, "DB"> &
	Partial<Pick<LocalProductEnv, "BETTER_AUTH_SECRET">> & {
		RUNTIME_CONTROLLER_NAMESPACE?: string;
		RUNTIME?: StartupRuntime & {
			currentExecution(input: ExecutionEnvironmentReference): Promise<boolean>;
		};
	};

export class ProductEntrypoint extends WorkerEntrypoint<ProductServiceEnv> {
	private startup() {
		if (!this.env.RUNTIME || !this.env.RUNTIME_CONTROLLER_NAMESPACE) throw new Error("startup_unavailable");
		return createRuntimeStartupService({ db: this.env.DB, namespace: this.env.RUNTIME_CONTROLLER_NAMESPACE, runtime: this.env.RUNTIME });
	}

	async registerStartup(input: RegisterStartup) { return this.startup().register(input); }
	async reserveStartup(input: StartupReference) { return this.startup().reserve(input); }
	async observeCapacity(input: CapacityReference) { return this.startup().observe(input); }
	async releaseCapacity(input: CapacityReference) { return this.startup().release(input); }
	async rotateIdentity(input: IdentityTransitionReference) { return this.startup().rotate(input); }
	async retireIdentity(input: IdentityTransitionReference) { return this.startup().retire(input); }

	async executionEnvironment(
		input: ExecutionEnvironmentReference,
	): Promise<Record<string, string>> {
		return executionEnvironment(input, {
			db: this.env.DB,
			secret: this.env.BETTER_AUTH_SECRET,
			currentExecution: (ref) =>
				this.env.RUNTIME?.currentExecution(ref) ?? Promise.resolve(false),
		});
	}

	private adapters() {
		const bindings = productEnv(this.env);
		if (!bindings) return null;
		return createProductAdapters(createDb(bindings), bindings.DB);
	}

	async reconstructCommand(
		commandId: string,
	): Promise<ReconstructedAdmission | null> {
		const adapters = this.adapters();
		if (!adapters) return null;
		return adapters.reconstructCommand(commandId);
	}

	async readCurrentAuthority(input: {
		workspaceSessionId: string;
		userId: string;
		projectId: string;
	}): Promise<CurrentAuthority | null> {
		const adapters = this.adapters();
		if (!adapters) return null;
		return adapters.readCurrentAuthority(input);
	}

	async applyProjections(
		payloads: ProjectionPayload[],
		now: number,
	): Promise<ProjectionApplyResult[]> {
		const adapters = this.adapters();
		if (!adapters) return [];
		return adapters.applyProjections(payloads, now);
	}

	async resolveWorkspaceSessionId(commandId: string): Promise<string | null> {
		const reconstructed = await this.reconstructCommand(commandId);
		return reconstructed?.command.workspaceSessionId ?? null;
	}

	async readExecutionPrerequisites(input: {
		workspaceSessionId: string;
		userId: string;
		projectId: string;
	}) {
		const adapters = this.adapters();
		if (!adapters) return null;
		return adapters.readExecutionPrerequisites(input);
	}
}
