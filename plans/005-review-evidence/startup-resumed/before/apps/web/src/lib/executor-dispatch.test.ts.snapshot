import { randomBytes } from "node:crypto";
import { mkdtemp, readFile, rm, writeFile } from "node:fs/promises";
import { tmpdir } from "node:os";
import path from "node:path";
import { afterEach, describe, expect, it, vi } from "vitest";
import type { RemoteToolV1 } from "../../../../packages/runtime-contracts/src/remote-tool";
import { executeRemoteTool } from "../../../../packages/sandbox-runner/src/remote-tool";
import { dispatchBrainRequest } from "../../../runtime/src/brain-dispatch";
import type { BrainRequest } from "../../../runtime/src/brain-transport";
import {
	createEffectExecutor,
	type ExecutionEnvironmentReference,
} from "../../../runtime/src/executor-dispatch";
import {
	handleRuntimeOutbound,
	type RuntimeSource,
} from "../../../runtime/src/runtime-egress";
import {
	createSessionRuntimeFixture,
	type SessionRuntimeFixture,
} from "../test/session-runtime-fixture";
import { encryptEnvVars } from "./project-env-vars";
import { executionEnvironment } from "./runtime-product-service";
import { handleSessionCommandRequest } from "./session-command";
import { createSqliteD1 } from "./sqlite-d1-test-utils";

const fixtures: SessionRuntimeFixture[] = [];
const workspaces: string[] = [];
afterEach(async () => {
	for (const f of fixtures.splice(0)) f.dispose();
	for (const w of workspaces.splice(0))
		await rm(w, { recursive: true, force: true });
	vi.restoreAllMocks();
});
async function setup() {
	const now = Date.now();
	const workspace = await mkdtemp(path.join(tmpdir(), "ditto-executor-"));
	workspaces.push(workspace);
	await writeFile(path.join(workspace, "source.txt"), "sandbox-only");
	let f: SessionRuntimeFixture;
	let serializedJob = "";
	let capturedEnv: Record<string, string> = {};
	let failAck = false;
	let environmentRace: (() => Promise<void>) | undefined;
	const secret = randomBytes(32).toString("hex");
	const project = randomBytes(32).toString("hex");
	const launch = { brain: {}, executor: {} };
	const rpc = {
		mkdir: vi.fn(async () => undefined),
		writeFile: vi.fn(async (_file: string, content: string) => {
			serializedJob = content;
		}),
		exec: vi.fn(
			async (_command: string, options: { env?: Record<string, string> }) => {
				capturedEnv = options.env ?? {};
				const job = JSON.parse(serializedJob) as RemoteToolV1;
				const result = await executeRemoteTool(job, {
					workspace,
					incarnation: "synthetic-executor-1",
					projectValues: capturedEnv.DITTO_EXECUTION_ENV
						? (JSON.parse(capturedEnv.DITTO_EXECUTION_ENV) as Record<
								string,
								string
							>)
						: {},
				});
				if (failAck) throw new Error("ack_lost");
				return { stdout: JSON.stringify({ version: 1, result }), exitCode: 0 };
			},
		),
	};
	const productEnvironment = vi.fn(
		async (reference: ExecutionEnvironmentReference) => {
			const values = await executionEnvironment(reference, {
				db: createSqliteD1(f.sqlite),
				secret,
				currentExecution: async (ref) => {
					const row = f.sqlite
						.prepare(
							"SELECT * FROM runtime_execution_admissions WHERE effectId = ?",
						)
						.get(ref.effectId) as {
						runId: string;
						assistantEntryId: string;
						toolCallId: string;
						attempt: number;
					};
					return f.coordinator("sess-1").currentExecution({ ...row, ...ref });
				},
			});
			await environmentRace?.();
			return values;
		},
	);
	f = createSessionRuntimeFixture({
		now: () => Date.now(),
		executeEffect: (input) =>
			createEffectExecutor({
				db: createSqliteD1(f.sqlite),
				controllerNamespace: "runtime",
				identity: {
					ownerId: "user-1",
					workspaceSessionId: "sess-1",
					projectId: "proj-1",
				},
				resolveSandbox: () => rpc,
				executionEnvironment: productEnvironment,
			})(input),
	});
	fixtures.push(f);
	f.seedTrustedSession();
	f.seedTrustedExecutionEvidence({
		executorIncarnationId: "synthetic-executor-1",
	});
	f.sqlite.exec(
		await readFile(
			path.resolve(
				process.cwd(),
				"migrations/0021_runtime_execution_admissions.sql",
			),
			"utf8",
		),
	);
	f.sqlite.exec(`UPDATE sandbox_identities SET controllerNamespace = 'runtime';
	CREATE TABLE privileged_operations (id text PRIMARY KEY, identityId text, family text, type text, contractVersion integer,
	 closedAt integer, expiresAt integer, lifecycleGeneration integer, incarnationId text, runtimeOwnerVersion integer,
	 runId text, runEpoch integer, admissionReference text);`);
	f.sqlite
		.prepare("UPDATE projects SET envVars = ?")
		.run(
			await encryptEnvVars([{ key: "PROJECT_VALUE", value: project }], secret),
		);
	await handleSessionCommandRequest({
		db: f.db,
		runtime: f.runtime,
		authenticatedUserId: "user-1",
		body: {
			version: 1,
			kind: "prompt",
			projectId: "proj-1",
			sessionId: "sess-1",
			idempotencyKey: "dispatch",
			text: "fake provider",
		},
	});
	await f.deliver();
	await f.coordinator("sess-1").reconcile();
	const command = f.sqlite
		.prepare("SELECT id, assistantMessageId FROM session_commands")
		.get() as { id: string; assistantMessageId: string };
	f.sqlite
		.prepare(
			`INSERT INTO privileged_operations VALUES ('bridge', 'brain-sess-1', 'ditto_action', 'brain_transport', 1, NULL, ?, 1, 'synthetic-brain-1', 1, ?, 1, ?)`,
		)
		.run(Math.floor(now / 1000) + 120, command.id, command.id);
	const source: RuntimeSource = {
		identityId: "brain-sess-1",
		containerId: "brain-container-sess-1",
		className: "SessionRuntime",
		kind: "trusted_brain",
		incarnation: "synthetic-brain-1",
		lifecycleGeneration: 1,
		ownerVersion: 1,
		userId: "user-1",
		projectId: "proj-1",
		workspaceSessionId: "sess-1",
	};
	const base: BrainRequest = {
		version: 1,
		kind: "continuation",
		brainIdentityId: source.identityId,
		brainIncarnationId: source.incarnation,
		runId: command.id,
		attempt: 1,
		runEpoch: 1,
		operationId: "bridge",
		expectedCommittedPosition: 0,
		payload: { providerResponse: { toolCallId: "call" } },
		ownerVersion: 1,
		lifecycleGeneration: 1,
		deadline: now + 30_000,
	};
	const network = vi.fn<typeof fetch>();
	const send = (
		kind: BrainRequest["kind"],
		payload: BrainRequest["payload"],
		position = 1,
	) =>
		handleRuntimeOutbound(
			new Request(`http://ditto.internal/v1/${kind}`, {
				method: "POST",
				headers: { "content-type": "application/json" },
				body: JSON.stringify({
					...base,
					kind,
					payload,
					expectedCommittedPosition: position,
				}),
			}),
			{ DB: createSqliteD1(f.sqlite), RUNTIME_CONTROLLER_NAMESPACE: "runtime" },
			{
				containerId: source.containerId,
				className: source.className,
				params: { incarnation: source.incarnation, lifecycleGeneration: 1 },
			},
			(s, request) => dispatchBrainRequest(f.coordinator("sess-1"), s, request),
			network,
		);
	expect((await send("continuation", base.payload, 0)).status).toBe(200);
	const job = (tool: RemoteToolV1["tool"], id = "call"): RemoteToolV1 => ({
		version: 1,
		runId: command.id,
		assistantEntryId: command.assistantMessageId,
		toolCallId: id,
		attempt: 1,
		executorIncarnationId: "synthetic-executor-1",
		runEpoch: 1,
		lifecycleGeneration: 1,
		deadline: base.deadline,
		outcomePolicy: tool.name === "bash" ? "never_retry" : "reconcile",
		tool,
	});
	return {
		f,
		workspace,
		rpc,
		send,
		job,
		project,
		secret,
		launch,
		network,
		productEnvironment,
		serializedJob: () => serializedJob,
		capturedEnv: () => capturedEnv,
		failAck: () => {
			failAck = true;
		},
		race: (callback: () => Promise<void>) => {
			environmentRace = callback;
		},
		command,
	};
}

describe("authenticated fake-provider bridge and real coordinator/dispatch, executor RPC fixture", () => {
	it("R1 commits encrypted remote results before delivery and deduplicates completed dispatch", async () => {
		const s = await setup();
		const job = s.job({ name: "read", path: "source.txt" });
		const first = await s.send("tool", job);
		expect(first.status).toBe(200);
		expect(JSON.stringify(await first.json()).includes("sandbox-only")).toBe(
			true,
		);
		expect((await s.send("tool", job)).status).toBe(200);
		expect(s.rpc.exec).toHaveBeenCalledTimes(1);
		const journal = s.f
			.coordinator("sess-1")
			.sql.query<{ state: string; result_ciphertext: string }>(
				"SELECT state, result_ciphertext FROM effects",
			)[0];
		expect(journal.state).toBe("result_recorded");
		expect(journal.result_ciphertext.includes("sandbox-only")).toBe(false);
		expect(s.network).not.toHaveBeenCalled();
		expect(s.productEnvironment).not.toHaveBeenCalled();
	});
	it("T30 decrypts only for admitted shell, keeps values out of launch/jobs and redacts before encrypted commit", async () => {
		const s = await setup();
		const job = s.job({
			name: "bash",
			command: 'printf "%s" "$PROJECT_VALUE"',
		});
		const response = await s.send("tool", job);
		expect(response.status).toBe(200);
		expect(JSON.stringify(await response.json()).includes(s.project)).toBe(
			false,
		);
		expect(s.serializedJob().includes(s.project)).toBe(false);
		expect(JSON.stringify(s.launch).includes(s.project)).toBe(false);
		expect(JSON.stringify(s.launch).includes(s.secret)).toBe(false);
		expect(JSON.stringify(s.capturedEnv()).includes(s.secret)).toBe(false);
		expect(JSON.stringify(s.capturedEnv()).includes(s.project)).toBe(true);
		expect(s.productEnvironment).toHaveBeenCalledTimes(1);
		expect(
			s.f.sqlite
				.prepare("SELECT closedAt FROM runtime_execution_admissions")
				.get(),
		).toMatchObject({ closedAt: expect.any(Number) });
	});
	it.each([
		null,
		{ content: [{ type: "text", text: 42 }] },
		{ content: [{ type: "text", text: "ok", authority: "fabricated" }] },
		{ content: [{ type: "image", mimeType: "text/html", data: "invalid" }] },
		{ content: [], isError: "false" },
		{ content: [], unexpected: "field" },
	])("R1 malformed executor result never crosses the encrypted-result barrier", async (result) => {
		const s = await setup();
		s.rpc.exec.mockResolvedValueOnce({
			stdout: JSON.stringify({ version: 1, result }),
			exitCode: 0,
		});
		const job = s.job({ name: "read", path: "source.txt" });
		expect((await s.send("tool", job)).status).toBe(403);
		expect((await s.send("tool", job)).status).toBe(403);
		expect(s.rpc.exec).toHaveBeenCalledTimes(1);
		expect(s.f.coordinator("sess-1").readSnapshot().runStates).toContainEqual(
			expect.objectContaining({
				status: "failed",
				reasonCode: "outcome_unknown",
			}),
		);
	});
	it("T30 Worker redacts project values in content, stderr, errors and result detail keys", async () => {
		const s = await setup();
		s.rpc.exec.mockResolvedValueOnce({
			stdout: JSON.stringify({
				version: 1,
				result: {
					content: [{ type: "text", text: s.project }],
					details: { [s.project]: { stderr: s.project, error: s.project } },
					isError: true,
				},
			}),
			exitCode: 0,
		});
		const response = await s.send(
			"tool",
			s.job({ name: "bash", command: "printf fixture" }),
		);
		expect(response.status).toBe(200);
		expect(JSON.stringify(await response.json()).includes(s.project)).toBe(
			false,
		);
		const result = await s.f.coordinator("sess-1").readEffectResult({
			runId: s.command.id,
			assistantEntryId: s.command.assistantMessageId,
			toolCallId: "call",
			attempt: 1,
		});
		expect(JSON.stringify(result).includes(s.project)).toBe(false);
	});
	it("T30 a shell cannot return an image-shaped secret channel", async () => {
		const s = await setup();
		s.rpc.exec.mockResolvedValueOnce({
			stdout: JSON.stringify({
				version: 1,
				result: {
					content: [
						{
							type: "image",
							mimeType: "image/png",
							data: Buffer.from(s.project).toString("base64"),
						},
					],
				},
			}),
			exitCode: 0,
		});
		expect(
			(await s.send("tool", s.job({ name: "bash", command: "printf fixture" })))
				.status,
		).toBe(403);
		expect(s.rpc.exec).toHaveBeenCalledTimes(1);
	});
	it("R1 lost shell acknowledgement becomes unknown without automatic redispatch", async () => {
		const s = await setup();
		s.failAck();
		const job = s.job({ name: "bash", command: "printf once >> outcome.txt" });
		expect((await s.send("tool", job)).status).toBe(403);
		expect((await s.send("tool", job)).status).toBe(403);
		expect(s.rpc.exec).toHaveBeenCalledTimes(1);
		expect(await readFile(path.join(s.workspace, "outcome.txt"), "utf8")).toBe(
			"once",
		);
		expect(s.f.coordinator("sess-1").readSnapshot().runStates).toContainEqual(
			expect.objectContaining({
				status: "failed",
				reasonCode: "outcome_unknown",
			}),
		);
	});
	it.each([
		"UPDATE sandbox_identities SET retiredAt = 1 WHERE kind = 'trusted_brain'",
		"UPDATE sandbox_identities SET incarnationId = 'replacement' WHERE kind = 'trusted_brain'",
		"UPDATE workspace_sessions SET status = 'archived'",
		"UPDATE privileged_operations SET closedAt = 1",
		"UPDATE privileged_operations SET expiresAt = 1",
		"UPDATE privileged_operations SET runEpoch = 2",
	])("R1 revoked brain cannot receive an in-flight result, but its outcome remains committed: %s", async (change) => {
		const s = await setup();
		const original = s.rpc.exec.getMockImplementation();
		if (!original) throw new Error("fixture_rpc_missing");
		s.rpc.exec.mockImplementationOnce(async (...args) => {
			const response = await original(...args);
			s.f.sqlite.exec(change);
			return response;
		});
		const job = s.job({ name: "bash", command: "printf once >> revoked.txt" });
		expect((await s.send("tool", job)).status).toBe(403);
		expect((await s.send("tool", job)).status).toBe(403);
		expect(s.rpc.exec).toHaveBeenCalledTimes(1);
		expect(await readFile(path.join(s.workspace, "revoked.txt"), "utf8")).toBe(
			"once",
		);
		expect(
			s.f
				.coordinator("sess-1")
				.sql.query<{ state: string }>("SELECT state FROM effects")[0].state,
		).toBe("result_recorded");
	});
	it("R1 overlapping delivery and a later tool cannot redispatch an in-flight operation", async () => {
		const s = await setup();
		const original = s.rpc.exec.getMockImplementation();
		if (!original) throw new Error("fixture_rpc_missing");
		let release = () => {};
		let entered = () => {};
		const pending = new Promise<void>((resolve) => {
			release = resolve;
		});
		const dispatched = new Promise<void>((resolve) => {
			entered = resolve;
		});
		s.rpc.exec.mockImplementationOnce(async (...args) => {
			entered();
			await pending;
			return original(...args);
		});
		const job = s.job({
			name: "bash",
			command: "printf once >> concurrent.txt",
		});
		const first = s.send("tool", job);
		await dispatched;
		try {
			expect((await s.send("tool", job)).status).toBe(403);
			expect(
				(
					await s.send(
						"tool",
						s.job({ name: "read", path: "source.txt" }, "later"),
					)
				).status,
			).toBe(403);
			expect(s.rpc.exec).toHaveBeenCalledTimes(1);
		} finally {
			release();
		}
		expect((await first).status).toBe(200);
		expect((await s.send("tool", job)).status).toBe(200);
		expect(s.rpc.exec).toHaveBeenCalledTimes(1);
		expect(
			await readFile(path.join(s.workspace, "concurrent.txt"), "utf8"),
		).toBe("once");
	});
	it.each([
		"UPDATE projects SET status = 'deleting'",
		"UPDATE projects SET userId = 'foreign'",
		"UPDATE workspace_sessions SET runtimeOwnerVersion = 2",
		"UPDATE workspace_sessions SET runtimeOwner = 'blocked'",
		"UPDATE sandbox_identities SET retiredAt = 1 WHERE kind = 'workspace_session'",
		"UPDATE sandbox_identities SET incarnationId = 'new' WHERE kind = 'workspace_session'",
		"UPDATE sandbox_identities SET lifecycleGeneration = 2 WHERE kind = 'workspace_session'",
	])("R1 authority changing during job preparation prevents execution: %s", async (change) => {
		const s = await setup();
		s.rpc.mkdir.mockImplementationOnce(async () => {
			s.f.sqlite.exec(change);
		});
		expect(
			(
				await s.send(
					"tool",
					s.job({ name: "bash", command: "printf late > late.txt" }),
				)
			).status,
		).toBe(403);
		expect(s.rpc.exec).not.toHaveBeenCalled();
		expect(s.productEnvironment).not.toHaveBeenCalled();
	});
	it("R1 failure closing D1 admission after execution blocks result delivery and future work", async () => {
		const s = await setup();
		s.f.sqlite.exec(`CREATE TRIGGER fail_admission_close BEFORE UPDATE OF closedAt ON runtime_execution_admissions
			BEGIN SELECT RAISE(ABORT, 'fixture_persistence_fault'); END;`);
		const job = s.job({
			name: "bash",
			command: "printf once >> close-fault.txt",
		});
		expect((await s.send("tool", job)).status).toBe(403);
		expect((await s.send("tool", job)).status).toBe(403);
		expect(s.rpc.exec).toHaveBeenCalledTimes(1);
		expect(
			await readFile(path.join(s.workspace, "close-fault.txt"), "utf8"),
		).toBe("once");
		expect(s.f.coordinator("sess-1").readSnapshot().runStates).toContainEqual(
			expect.objectContaining({
				status: "failed",
				reasonCode: "outcome_unknown",
			}),
		);
	});
	it("R1 persistence failure never delivers the result or admits another effect", async () => {
		const s = await setup();
		const coord = s.f.coordinator("sess-1");
		const original = coord.sql.query.bind(coord.sql);
		vi.spyOn(coord.sql, "query").mockImplementation((query, ...args) => {
			if (query.includes("UPDATE effects") && args[0] === "result_recorded")
				throw new Error("disk_fault");
			return original(query, ...args);
		});
		expect(
			(await s.send("tool", s.job({ name: "read", path: "source.txt" })))
				.status,
		).toBe(403);
		expect(
			(
				await s.send(
					"tool",
					s.job({ name: "read", path: "source.txt" }, "later"),
				)
			).status,
		).toBe(403);
		expect(s.rpc.exec).toHaveBeenCalledTimes(1);
	});
	it("R2 prompt acceptance persists bounded startup intent without admitting an execution effect", async () => {
		const s = await setup();
		const intent = s.f.sqlite
			.prepare(
				"SELECT startupRoles, startupPools, expectedIdentityId, startupDeadline, runtimeOwnerVersion FROM workspace_runtime_work",
			)
			.get();
		expect(intent).toMatchObject({
			startupRoles: '["trusted_brain","workspace_session"]',
			startupPools: '["brain","execution"]',
			expectedIdentityId: "brain-sess-1",
			runtimeOwnerVersion: 1,
			startupDeadline: expect.any(Number),
		});
		expect(s.rpc.exec).not.toHaveBeenCalled();
		expect(
			s.f.sqlite
				.prepare("SELECT count(*) AS n FROM runtime_execution_admissions")
				.get(),
		).toMatchObject({ n: 0 });
	});
	it("T30 fabricated, expired, wrong-owner, incarnation, closed and replayed references never materialize values", async () => {
		const s = await setup();
		expect(
			(
				await s.send(
					"tool",
					s.job({ name: "bash", command: "printf authorized" }),
				)
			).status,
		).toBe(200);
		const row = s.f.sqlite
			.prepare(
				"SELECT effectId, identityId, incarnationId, ownerVersion FROM runtime_execution_admissions",
			)
			.get() as {
			effectId: string;
			identityId: string;
			incarnationId: string;
			ownerVersion: number;
		};
		const reference = {
			effectId: row.effectId,
			identityId: row.identityId,
			incarnation: row.incarnationId,
			ownerVersion: row.ownerVersion,
		};
		const currentExecution = vi.fn(async () => true);
		for (const input of [
			reference,
			{ ...reference, effectId: "fabricated" },
			{ ...reference, identityId: "foreign" },
			{ ...reference, incarnation: "retired" },
			{ ...reference, ownerVersion: 2 },
		]) {
			await expect(
				executionEnvironment(input, {
					db: createSqliteD1(s.f.sqlite),
					secret: s.secret,
					currentExecution,
				}),
			).rejects.toThrow("execution_environment_denied");
		}
		expect(currentExecution).not.toHaveBeenCalled();
		s.f.sqlite.exec(
			"UPDATE runtime_execution_admissions SET closedAt = NULL, deadline = 1",
		);
		await expect(
			executionEnvironment(reference, {
				db: createSqliteD1(s.f.sqlite),
				secret: s.secret,
				currentExecution,
			}),
		).rejects.toThrow("execution_environment_denied");
		expect(currentExecution).not.toHaveBeenCalled();
	});
	it.each([
		"UPDATE projects SET status = 'deleting'",
		"UPDATE projects SET userId = 'foreign'",
		"UPDATE workspace_sessions SET runtimeOwnerVersion = 2",
		"UPDATE sandbox_identities SET retiredAt = 1 WHERE kind = 'workspace_session'",
		"UPDATE sandbox_identities SET incarnationId = 'new' WHERE kind = 'workspace_session'",
		"UPDATE runtime_execution_admissions SET closedAt = 1",
		"UPDATE runtime_execution_admissions SET deadline = 1",
	])("T30 final coordinator callback cannot race fresh product authority: %s", async (change) => {
		const s = await setup();
		expect(
			(await s.send("tool", s.job({ name: "bash", command: "printf fixture" })))
				.status,
		).toBe(200);
		s.f.sqlite.exec("UPDATE runtime_execution_admissions SET closedAt = NULL");
		const row = s.f.sqlite
			.prepare(
				"SELECT effectId, identityId, incarnationId, ownerVersion FROM runtime_execution_admissions",
			)
			.get() as {
			effectId: string;
			identityId: string;
			incarnationId: string;
			ownerVersion: number;
		};
		let calls = 0;
		const operation = executionEnvironment(
			{ ...row, incarnation: row.incarnationId },
			{
				db: createSqliteD1(s.f.sqlite),
				secret: s.secret,
				currentExecution: async () => {
					if (++calls === 2) s.f.sqlite.exec(change);
					return true;
				},
			},
		);
		await expect(operation.then(() => true)).rejects.toThrow(
			"execution_environment_denied",
		);
	});
	it("T30 Stop racing environment materialization prevents the authorized child from starting", async () => {
		const s = await setup();
		s.race(async () => {
			await handleSessionCommandRequest({
				db: s.f.db,
				runtime: s.f.runtime,
				authenticatedUserId: "user-1",
				body: {
					version: 1,
					kind: "stop",
					projectId: "proj-1",
					sessionId: "sess-1",
					idempotencyKey: "stop-race",
					targetRunId: s.command.id,
				},
			});
			await s.f.deliver();
		});
		expect(
			(
				await s.send(
					"tool",
					s.job({ name: "bash", command: "printf late > late.txt" }),
				)
			).status,
		).toBe(403);
		expect(s.rpc.exec).not.toHaveBeenCalled();
	});
});
