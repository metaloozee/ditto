{
  "compilerOptions": { "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "strict": true, "paths": { "#/*": ["../web/src/*"] }, "skipLibCheck": true, "types": ["@cloudflare/workers-types", "node"], "lib": ["ES2022", "WebWorker", "WebWorker.Iterable"], "allowImportingTsExtensions": true },
  "include": ["src/**/*.ts", "types/**/*.d.ts"],
  "exclude": ["src/forbidden-bindings.type-test.ts"]
}
