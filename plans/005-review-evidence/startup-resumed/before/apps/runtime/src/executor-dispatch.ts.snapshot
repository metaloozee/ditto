import type { ExecOptions } from "@cloudflare/sandbox";
import {
	decodeContractInput,
	strictRecord,
} from "../../../packages/runtime-contracts/src/json.js";
import {
	parseRemoteToolResult,
	parseRemoteToolV1,
	REMOTE_RESULT_BYTES,
} from "../../../packages/runtime-contracts/src/remote-tool.js";
import { redactSecrets } from "../../web/src/lib/secret-redaction.js";
import type { EffectExecutor } from "./session-runtime.js";

export type ExecutorRpc = {
	mkdir(path: string, options: { recursive: boolean }): Promise<unknown>;
	writeFile(path: string, content: string): Promise<unknown>;
	exec(
		command: string,
		options: ExecOptions,
	): Promise<{ stdout: string; exitCode: number }>;
};
export type ExecutionEnvironmentReference = {
	effectId: string;
	identityId: string;
	incarnation: string;
	ownerVersion: number;
};
export async function effectReference(input: {
	runId: string;
	assistantEntryId: string;
	toolCallId: string;
	attempt: number;
}): Promise<string> {
	const bytes = new TextEncoder().encode(
		JSON.stringify([
			input.runId,
			input.assistantEntryId,
			input.toolCallId,
			input.attempt,
		]),
	);
	return [...new Uint8Array(await crypto.subtle.digest("SHA-256", bytes))]
		.map((byte) => byte.toString(16).padStart(2, "0"))
		.join("");
}
function quote(value: string): string {
	return `'${value.replaceAll("'", "'\\''")}'`;
}

function redactResult(value: unknown, secrets: readonly string[]): unknown {
	if (typeof value === "string") return redactSecrets(value, secrets);
	if (Array.isArray(value))
		return value.map((item) => redactResult(item, secrets));
	if (value === null || typeof value !== "object") return value;
	const result: Record<string, unknown> = {};
	for (const [key, item] of Object.entries(value)) {
		const redactedKey = redactSecrets(key, secrets);
		if (Object.hasOwn(result, redactedKey))
			throw new Error("result_key_conflict");
		Object.defineProperty(result, redactedKey, {
			value: redactResult(item, secrets),
			enumerable: true,
			writable: true,
		});
	}
	return result;
}

export function createEffectExecutor(deps: {
	db: D1Database;
	controllerNamespace: string;
	identity: { ownerId: string; workspaceSessionId: string; projectId: string };
	resolveSandbox: (sandboxId: string) => ExecutorRpc;
	executionEnvironment: (
		input: ExecutionEnvironmentReference,
	) => Promise<Record<string, string>>;
	now?: () => number;
}): EffectExecutor {
	return async ({ effect, executorIdentityId, ownerVersion, revalidate }) => {
		const now = deps.now ?? Date.now;
		const { state: _state, arguments: tool, ...identity } = effect;
		const job = parseRemoteToolV1({ ...identity, tool });
		const effectId = await effectReference(effect);
		await revalidate();
		const resolveTarget = () =>
			deps.db
				.prepare(`SELECT i.sandboxId FROM sandbox_identities i
			JOIN workspace_sessions s ON s.id = i.workspaceSessionId AND s.userId = i.userId AND s.projectId = i.projectId
			JOIN projects p ON p.id = i.projectId AND p.userId = i.userId
			WHERE i.id = ? AND i.incarnationId = ? AND i.lifecycleGeneration = ? AND i.controllerClass = 'Sandbox'
			AND i.controllerNamespace = ? AND i.kind = 'workspace_session' AND i.retiredAt IS NULL AND i.state = 'ready'
			AND s.id = ? AND s.userId = ? AND s.projectId = ? AND s.sandboxIdentityId = i.id
			AND s.runtimeOwner = 'trusted_v1' AND s.runtimeOwnerVersion = ? AND s.status = 'active' AND p.status != 'deleting'
			AND NOT EXISTS (SELECT 1 FROM runtime_deleted_target_fences f WHERE (f.targetKind = 'project' AND f.targetId = p.id)
				OR (f.targetKind = 'workspace_session' AND f.targetId = s.id))`)
				.bind(
					executorIdentityId,
					effect.executorIncarnationId,
					effect.lifecycleGeneration,
					deps.controllerNamespace,
					deps.identity.workspaceSessionId,
					deps.identity.ownerId,
					deps.identity.projectId,
					ownerVersion,
				)
				.first<{ sandboxId: string }>();
		const target = await resolveTarget();
		if (!target || job.deadline <= now())
			throw new Error("execution_authority");
		const guard = async () => {
			await revalidate();
			const current = await resolveTarget();
			if (
				!current ||
				current.sandboxId !== target.sandboxId ||
				job.deadline <= now()
			)
				throw new Error("execution_authority");
		};
		await deps.db
			.prepare(`INSERT INTO runtime_execution_admissions
			(effectId, sessionId, userId, projectId, identityId, incarnationId, lifecycleGeneration, ownerVersion, runId, runEpoch,
			assistantEntryId, toolCallId, attempt, toolName, deadline, closedAt)
			VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, NULL)`)
			.bind(
				effectId,
				deps.identity.workspaceSessionId,
				deps.identity.ownerId,
				deps.identity.projectId,
				executorIdentityId,
				effect.executorIncarnationId,
				effect.lifecycleGeneration,
				ownerVersion,
				effect.runId,
				effect.runEpoch,
				effect.assistantEntryId,
				effect.toolCallId,
				effect.attempt,
				job.tool.name,
				job.deadline,
			)
			.run();
		try {
			const sandbox = deps.resolveSandbox(target.sandboxId);
			const jobPath = `/tmp/ditto-remote-jobs/${crypto.randomUUID()}.json`;
			await guard();
			await sandbox.mkdir("/tmp/ditto-remote-jobs", { recursive: true });
			await guard();
			await sandbox.writeFile(jobPath, JSON.stringify(job));
			await guard();
			const reference = {
				effectId,
				identityId: executorIdentityId,
				incarnation: effect.executorIncarnationId,
				ownerVersion,
			};
			let values: Record<string, string> = {};
			if (job.tool.name === "bash")
				values = await deps.executionEnvironment(reference);
			await guard();
			const command = `/usr/bin/env -i PATH=/usr/local/bin:/usr/bin:/bin HOME=/tmp LANG=C.UTF-8 DITTO_EXECUTION_ENV="$DITTO_EXECUTION_ENV" /usr/local/bin/node /opt/ditto-runner/dist/remote-tool-cli.js ${quote(jobPath)} ${quote(job.executorIncarnationId)}`;
			// One RPC only. An ambiguous acknowledgement never retries the command.
			const response = await sandbox.exec(command, {
				cwd: "/workspace",
				timeout: Math.max(1, job.deadline - now()),
				env:
					job.tool.name === "bash"
						? { DITTO_EXECUTION_ENV: JSON.stringify(values) }
						: {},
				origin: "internal",
			});
			const parsed = strictRecord(
				decodeContractInput(response.stdout, REMOTE_RESULT_BYTES + 1024),
				["version", "result", "error"],
				"ExecutorResult",
			);
			if (
				parsed.version !== 1 ||
				response.exitCode !== 0 ||
				parsed.error !== undefined ||
				parsed.result === undefined
			)
				throw new Error("executor_acknowledgement");
			const result = parseRemoteToolResult(parsed.result, job.tool.name);
			return parseRemoteToolResult(
				redactResult(result, Object.values(values)),
				job.tool.name,
			);
		} finally {
			await deps.db
				.prepare(
					"UPDATE runtime_execution_admissions SET closedAt = ? WHERE effectId = ? AND closedAt IS NULL",
				)
				.bind(now(), effectId)
				.run();
		}
	};
}
