import { strictRecord } from "../../../packages/runtime-contracts/src/json.js";
import { parseRemoteToolV1 } from "../../../packages/runtime-contracts/src/remote-tool.js";
import type { BrainRequest } from "./brain-transport.js";
import { TransportDenied } from "./brain-transport.js";
import { continuationPosition } from "./journal.js";
import type { RuntimeSource } from "./runtime-egress.js";
import type { SessionCoordinator } from "./session-runtime.js";

export async function dispatchBrainRequest(
	coordinator: SessionCoordinator,
	source: RuntimeSource,
	request: BrainRequest,
): Promise<unknown> {
	if (
		coordinator.identity.workspaceSessionId !== source.workspaceSessionId ||
		coordinator.identity.ownerId !== source.userId ||
		coordinator.identity.projectId !== source.projectId ||
		request.deadline <= coordinator.clock.now()
	)
		throw new TransportDenied("coordinator_identity");
	if (request.kind === "readiness") return { ready: true, terminal: false };
	if (request.kind === "continuation")
		return coordinator.commitContinuation({
			expectedPosition: request.expectedCommittedPosition,
			snapshot: request.payload,
			runId: request.runId,
			brainIncarnationId: source.incarnation,
			lifecycleGeneration: source.lifecycleGeneration,
			ownerVersion: source.ownerVersion,
			runEpoch: request.runEpoch,
		});
	if (request.kind === "tool" || request.kind === "result") {
		const job = parseRemoteToolV1(request.payload);
		if (
			job.runId !== request.runId ||
			job.runEpoch !== request.runEpoch ||
			job.attempt !== request.attempt ||
			job.lifecycleGeneration !== source.lifecycleGeneration ||
			job.deadline > request.deadline
		)
			throw new TransportDenied("effect_envelope");
		if (
			request.expectedCommittedPosition < 1 ||
			request.expectedCommittedPosition !==
				continuationPosition(coordinator.sql)
		)
			throw new TransportDenied("continuation_position");
		if (request.kind === "tool") {
			const { tool, ...identity } = job;
			await coordinator.admitEffect({
				...identity,
				arguments: tool,
				state: "prepared",
			});
		}
		return coordinator.readEffectResult(job);
	}
	const control = strictRecord(request.payload, ["action"], "BrainControl");
	if (control.action === "read_snapshot") return coordinator.readSnapshot();
	throw new TransportDenied("control_action");
}
