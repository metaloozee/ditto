+		record.identityId === launch.identityId &&
+		record.incarnationId === launch.incarnationId &&
+		record.lifecycleGeneration === launch.lifecycleGeneration &&
+		record.containerId === launch.containerId &&
+		record.controllerClass === launch.controllerClass &&
+		record.controllerNamespace === launch.controllerNamespace;
