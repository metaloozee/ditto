+		incarnationId: assignment.incarnationId,
+		lifecycleGeneration: assignment.lifecycleGeneration,
+		containerId: platform.containerId,
+		controllerClass: platform.controllerClass,
+		controllerNamespace: platform.controllerNamespace,
+		phase: "starting",
+	};
