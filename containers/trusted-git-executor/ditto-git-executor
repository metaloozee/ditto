#!/bin/sh
# Fixed Trusted Git Executor helper. Worker-selected subcommands only.
# Never evaluates caller shell text; never prints raw git packet/object data.
set -eu

HELPER_VERSION="1"
STATE_ROOT="${DITTO_GIT_EXECUTOR_STATE:-/var/lib/ditto-git-executor}"
QUARANTINE_DIR="${STATE_ROOT}/quarantine"
EMPTY_HOME="${STATE_ROOT}/home"
EMPTY_CONFIG="${EMPTY_HOME}/.gitconfig-empty"
HOOKS_DISABLED="${EMPTY_HOME}/hooks-disabled"
CA_BUNDLE="${EMPTY_HOME}/ca-bundle.crt"
MAX_BUNDLE_BYTES=$((64 * 1024 * 1024))
MAX_OBJECT_BYTES=$((256 * 1024 * 1024))
MAX_BLOB_BYTES=$((8 * 1024 * 1024))
MAX_OBJECTS=100000
MAX_COMMITS=1000
MAX_PATH_RECORDS=20000
# Test-only override: positive int strictly below production max.
if [ -n "${DITTO_TEST_MAX_PATH_RECORDS:-}" ]; then
	case "${DITTO_TEST_MAX_PATH_RECORDS}" in
	'' | *[!0-9]*) ;;
	*)
		if [ "${DITTO_TEST_MAX_PATH_RECORDS}" -ge 1 ] &&
			[ "${DITTO_TEST_MAX_PATH_RECORDS}" -lt "${MAX_PATH_RECORDS}" ]; then
			MAX_PATH_RECORDS="${DITTO_TEST_MAX_PATH_RECORDS}"
		fi
		;;
	esac
fi
PUSH_ATTEMPT_FILE="${STATE_ROOT}/push-attempts"

emit_json() {
	# $1 code, $2 message, optional extra JSON object fields already encoded
	code="$1"
	msg="$2"
	extra="${3:-}"
	msg=$(printf '%s' "$msg" | tr '\n\r\t' '   ' | cut -c1-512)
	msg=$(printf '%s' "$msg" | sed 's/\\/\\\\/g; s/"/\\"/g')
	if [ -n "$extra" ]; then
		printf '{"ok":%s,"code":"%s","message":"%s",%s}\n' \
			"$([ "$code" = "ok" ] && echo true || echo false)" \
			"$code" "$msg" "$extra"
	else
		printf '{"ok":%s,"code":"%s","message":"%s"}\n' \
			"$([ "$code" = "ok" ] && echo true || echo false)" \
			"$code" "$msg"
	fi
}

fail() {
	code="$1"
	msg="$2"
	extra="${3:-}"
	emit_json "$code" "$msg" "$extra" >&1
	exit 1
}

ok_result() {
	msg="$1"
	extra="${2:-}"
	emit_json "ok" "$msg" "$extra"
	exit 0
}

cleanup_state() {
	rm -rf "${QUARANTINE_DIR}" 2>/dev/null || true
	rm -rf "${STATE_ROOT}/tmp" 2>/dev/null || true
	rm -f "${PUSH_ATTEMPT_FILE}" 2>/dev/null || true
}

prepare_home() {
	mkdir -p "${EMPTY_HOME}" "${HOOKS_DISABLED}" "${STATE_ROOT}/tmp"
	chmod 700 "${EMPTY_HOME}" "${HOOKS_DISABLED}" "${STATE_ROOT}/tmp"
	: >"${EMPTY_CONFIG}"
	chmod 600 "${EMPTY_CONFIG}"
	prepare_ca_bundle
}

# Trust system CA always; when Cloudflare interception CA is mounted, append it.
# Never disable TLS verification. env -i drops ambient SSL_CERT_FILE, so export here.
prepare_ca_bundle() {
	sys_ca="/etc/ssl/certs/ca-certificates.crt"
	cf_ca="/etc/cloudflare/certs/cloudflare-containers-ca.crt"
	if [ -f "$sys_ca" ]; then
		cp "$sys_ca" "$CA_BUNDLE"
	else
		: >"$CA_BUNDLE"
	fi
	if [ -f "$cf_ca" ]; then
		printf '\n' >>"$CA_BUNDLE"
		cat "$cf_ca" >>"$CA_BUNDLE"
	fi
	chmod 600 "$CA_BUNDLE"
}

git_ca_env() {
	# Printed as env assignments consumed by run_git_*
	printf '%s' "SSL_CERT_FILE=${CA_BUNDLE} CURL_CA_BUNDLE=${CA_BUNDLE} GIT_SSL_CAINFO=${CA_BUNDLE}"
}

# Stock git with a sealed environment. Never inherits caller env secrets.
run_git_local() {
	env -i \
		PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin" \
		HOME="${EMPTY_HOME}" \
		XDG_CONFIG_HOME="${EMPTY_HOME}/.config" \
		LANG=C \
		LC_ALL=C \
		SSL_CERT_FILE="${CA_BUNDLE}" \
		CURL_CA_BUNDLE="${CA_BUNDLE}" \
		GIT_SSL_CAINFO="${CA_BUNDLE}" \
		GIT_TERMINAL_PROMPT=0 \
		GIT_CONFIG_NOSYSTEM=1 \
		GIT_CONFIG_GLOBAL="${EMPTY_CONFIG}" \
		GIT_TRACE=0 \
		GIT_TRACE_SETUP=0 \
		GIT_CURL_VERBOSE=0 \
		GIT_CONFIG_COUNT=7 \
		GIT_CONFIG_KEY_0=protocol.allow \
		GIT_CONFIG_VALUE_0=never \
		GIT_CONFIG_KEY_1=protocol.https.allow \
		GIT_CONFIG_VALUE_1=always \
		GIT_CONFIG_KEY_2=protocol.file.allow \
		GIT_CONFIG_VALUE_2=always \
		GIT_CONFIG_KEY_3=core.hooksPath \
		GIT_CONFIG_VALUE_3="${HOOKS_DISABLED}" \
		GIT_CONFIG_KEY_4=credential.helper \
		GIT_CONFIG_VALUE_4= \
		GIT_CONFIG_KEY_5=http.followRedirects \
		GIT_CONFIG_VALUE_5=false \
		GIT_CONFIG_KEY_6=core.askPass \
		GIT_CONFIG_VALUE_6= \
		/usr/bin/git "$@"
}

# Network git (ls-remote/push). file protocol denied. CA bundle always set.
run_git_net() {
	env -i \
		PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin" \
		HOME="${EMPTY_HOME}" \
		XDG_CONFIG_HOME="${EMPTY_HOME}/.config" \
		LANG=C \
		LC_ALL=C \
		SSL_CERT_FILE="${CA_BUNDLE}" \
		CURL_CA_BUNDLE="${CA_BUNDLE}" \
		GIT_SSL_CAINFO="${CA_BUNDLE}" \
		GIT_TERMINAL_PROMPT=0 \
		GIT_CONFIG_NOSYSTEM=1 \
		GIT_CONFIG_GLOBAL="${EMPTY_CONFIG}" \
		GIT_TRACE=0 \
		GIT_TRACE_SETUP=0 \
		GIT_CURL_VERBOSE=0 \
		GIT_CONFIG_COUNT=8 \
		GIT_CONFIG_KEY_0=protocol.allow \
		GIT_CONFIG_VALUE_0=never \
		GIT_CONFIG_KEY_1=protocol.https.allow \
		GIT_CONFIG_VALUE_1=always \
		GIT_CONFIG_KEY_2=protocol.file.allow \
		GIT_CONFIG_VALUE_2=never \
		GIT_CONFIG_KEY_3=core.hooksPath \
		GIT_CONFIG_VALUE_3="${HOOKS_DISABLED}" \
		GIT_CONFIG_KEY_4=credential.helper \
		GIT_CONFIG_VALUE_4= \
		GIT_CONFIG_KEY_5=http.followRedirects \
		GIT_CONFIG_VALUE_5=false \
		GIT_CONFIG_KEY_6=core.askPass \
		GIT_CONFIG_VALUE_6= \
		GIT_CONFIG_KEY_7=http.sslCAInfo \
		GIT_CONFIG_VALUE_7="${CA_BUNDLE}" \
		/usr/bin/git "$@"
}

is_sha1() {
	printf '%s' "$1" | grep -Eq '^[0-9a-f]{40}$'
}

# Mirror git check-ref-format for refs/heads/*:
# no leading-dot components, no .lock, no trailing dots, no @{, etc.
is_heads_ref() {
	ref="$1"
	case "$ref" in
	refs/heads/*) ;;
	*) return 1 ;;
	esac
	body="${ref#refs/heads/}"
	[ -n "$body" ] || return 1
	[ "${#ref}" -le 512 ] || return 1
	case "$body" in
	*..* | *//* | *@\{* | *\\* | *. | */ | /* | *" "* | *$'\n'* | *$'\r'* | *$'\t'* | *'~'* | *'^'* | *':'* | *'?'* | *'*'* | *'['* | @)
		return 1
		;;
	esac
	# Component-wise checks
	old_ifs=$IFS
	IFS=/
	# shellcheck disable=SC2086
	set -- $body
	IFS=$old_ifs
	for part in "$@"; do
		[ -n "$part" ] || return 1
		case "$part" in
		.* | *. | *.lock | @) return 1 ;;
		esac
		printf '%s' "$part" | grep -Eq '^[A-Za-z0-9._-]+$' || return 1
	done
	# Prefer stock check-ref-format when git is available (post prepare_home).
	if [ -x /usr/bin/git ] && [ -f "${EMPTY_CONFIG}" ]; then
		run_git_local check-ref-format --normalize "$ref" >/dev/null 2>&1 || return 1
	fi
	return 0
}

is_safe_name() {
	printf '%s' "$1" | grep -Eq '^[A-Za-z0-9._-]{1,100}$' || return 1
	case "$1" in
	.* | -* | *..*) return 1 ;;
	esac
	return 0
}

hex_sha256_file() {
	if command -v sha256sum >/dev/null 2>&1; then
		sha256sum "$1" | awk '{print $1}'
	else
		openssl dgst -sha256 "$1" | awk '{print $NF}'
	fi
}

# Stream stdin to path with exact byte cap (expected_size). Rejects oversize
# without relying on rounded dd block multiples.
stream_stdin_capped() {
	out_path="$1"
	expected_size="$2"
	# Read expected_size+1 bytes max; exact match required.
	# head -c is exact on busybox/gnu.
	max=$((expected_size + 1))
	# shellcheck disable=SC2002
	if command -v head >/dev/null 2>&1; then
		head -c "$max" >"$out_path" || true
	else
		dd bs=4096 "count=$(( (max + 4095) / 4096 ))" of="$out_path" status=none 2>/dev/null || true
	fi
	actual=$(wc -c <"$out_path" | tr -d ' ')
	[ "$actual" = "$expected_size" ] || return 1
	return 0
}

cmd_hold() {
	while true; do
		sleep 3600
	done
}

cmd_scan_canary() {
	canary=$(dd bs=4096 count=1 status=none 2>/dev/null | tr -d '\n\r' || true)
	[ -n "$canary" ] || fail "invalid_args" "canary required"
	[ "${#canary}" -le 256 ] || fail "invalid_args" "canary too long"
	hits=0
	for path in /proc/[0-9]*/cmdline /proc/[0-9]*/environ; do
		case "$path" in
		"/proc/self/"* | "/proc/$$/"*) continue ;;
		esac
		if [ -r "$path" ] && grep -a -F -q -- "$canary" "$path" 2>/dev/null; then
			hits=$((hits + 1))
		fi
	done
	if [ -d "${STATE_ROOT}" ]; then
		if grep -a -R -F -q -- "$canary" "${STATE_ROOT}" 2>/dev/null; then
			hits=$((hits + 1))
		fi
	fi
	# Also scan common log paths if present
	for path in /tmp /var/tmp; do
		if [ -d "$path" ] && grep -a -R -F -q -- "$canary" "$path" 2>/dev/null; then
			hits=$((hits + 1))
		fi
	done
	unset canary
	if [ "$hits" -eq 0 ]; then
		ok_result "canary absent" '"hits":0'
	else
		fail "canary_present" "canary detected" "\"hits\":${hits}"
	fi
}

reject_lfs_and_gitlinks() {
	# Submodule gitlinks (mode 160000) across all reachable commits.
	set +e
	run_git_local --git-dir="${QUARANTINE_DIR}" log --all --raw --no-abbrev 2>/dev/null \
		| grep -qE '^:[0-9]{6} 160000 '
	gl_rc=$?
	set -e
	[ "$gl_rc" -eq 0 ] && fail "submodule" "submodule gitlink present in history"

	# LFS pointer blobs: small blobs starting with the LFS pointer header.
	obj_list=$(run_git_local --git-dir="${QUARANTINE_DIR}" cat-file --batch-check --batch-all-objects 2>/dev/null) \
		|| fail "objects_failed" "object enumeration failed"
	lfs_hit=0
	scan_err=0
	# Avoid pipeline+set -e swallowing the fail path: iterate without pipe.
	tmp_list="${STATE_ROOT}/tmp/obj-list.txt"
	mkdir -p "${STATE_ROOT}/tmp"
	printf '%s\n' "$obj_list" >"$tmp_list"
	while IFS= read -r line; do
		[ -n "$line" ] || continue
		sha=$(printf '%s' "$line" | awk '{print $1}')
		otype=$(printf '%s' "$line" | awk '{print $2}')
		osize=$(printf '%s' "$line" | awk '{print $3}')
		[ "$otype" = "blob" ] || continue
		case "$osize" in
		'' | *[!0-9]*) scan_err=1; break ;;
		esac
		[ "$osize" -le 300 ] || continue
		[ "$osize" -ge 20 ] || continue
		hdr=$(run_git_local --git-dir="${QUARANTINE_DIR}" cat-file -p "$sha" 2>/dev/null | head -n 1 || true)
		case "$hdr" in
		"version https://git-lfs.github.com/spec/v1")
			lfs_hit=1
			break
			;;
		esac
	done <"$tmp_list"
	rm -f "$tmp_list"
	[ "$scan_err" -eq 0 ] || fail "objects_failed" "object scan failed"
	[ "$lfs_hit" -eq 0 ] || fail "lfs" "lfs pointer blob present"
}

import_bundle_into_quarantine() {
	bundle_path="$1"
	expected_ref="$2"
	expected_tip="$3"
	expected_old="$4" # empty string means absent

	rm -rf "${QUARANTINE_DIR}"
	mkdir -m 700 "${QUARANTINE_DIR}"

	run_git_local -c init.templateDir= init --bare "${QUARANTINE_DIR}" >/dev/null 2>&1 \
		|| fail "init_failed" "bare init failed"

	run_git_local --git-dir="${QUARANTINE_DIR}" config core.repositoryFormatVersion 0 >/dev/null 2>&1 || true
	run_git_local --git-dir="${QUARANTINE_DIR}" config extensions.worktreeConfig false >/dev/null 2>&1 || true
	rm -f "${QUARANTINE_DIR}/objects/info/alternates" \
		"${QUARANTINE_DIR}/objects/info/http-alternates" 2>/dev/null || true

	list_out=$(run_git_local bundle list-heads "$bundle_path" 2>/dev/null) \
		|| fail "bundle_invalid" "bundle list failed"
	ref_count=$(printf '%s\n' "$list_out" | sed '/^$/d' | wc -l | tr -d ' ')
	[ "$ref_count" = "1" ] || fail "bundle_refs" "expected exactly one ref"

	listed_sha=$(printf '%s\n' "$list_out" | awk 'NR==1 {print $1}')
	listed_ref=$(printf '%s\n' "$list_out" | awk 'NR==1 {$1=""; sub(/^ /,""); print}')
	is_sha1 "$listed_sha" || fail "bundle_refs" "invalid listed sha"
	[ "$listed_ref" = "$expected_ref" ] || fail "bundle_refs" "unexpected ref"
	[ "$listed_sha" = "$expected_tip" ] || fail "bundle_tip" "tip mismatch"

	run_git_local --git-dir="${QUARANTINE_DIR}" fetch --no-tags --no-recurse-submodules \
		"$bundle_path" "refs/heads/*:refs/heads/*" >/dev/null 2>&1 \
		|| fail "bundle_import" "bundle fetch failed"

	refs_out=$(run_git_local --git-dir="${QUARANTINE_DIR}" for-each-ref --format='%(refname) %(objectname)' 2>/dev/null) \
		|| fail "refs_list" "for-each-ref failed"
	ref_lines=$(printf '%s\n' "$refs_out" | sed '/^$/d' | wc -l | tr -d ' ')
	[ "$ref_lines" = "1" ] || fail "extra_refs" "unexpected refs present"
	got_ref=$(printf '%s\n' "$refs_out" | awk 'NR==1 {print $1}')
	got_sha=$(printf '%s\n' "$refs_out" | awk 'NR==1 {print $2}')
	[ "$got_ref" = "$expected_ref" ] || fail "bundle_refs" "imported ref mismatch"
	[ "$got_sha" = "$expected_tip" ] || fail "bundle_tip" "imported tip mismatch"

	run_git_local --git-dir="${QUARANTINE_DIR}" fsck --full --strict --no-progress >/dev/null 2>&1 \
		|| fail "fsck_failed" "strict fsck failed"

	if [ -f "${QUARANTINE_DIR}/shallow" ]; then
		fail "shallow_or_promisor" "shallow state present"
	fi
	if ls "${QUARANTINE_DIR}/objects/pack"/*.promisor >/dev/null 2>&1; then
		fail "shallow_or_promisor" "promisor state present"
	fi
	if [ -f "${QUARANTINE_DIR}/objects/info/alternates" ]; then
		fail "alternates" "alternates present"
	fi
	if [ -d "${QUARANTINE_DIR}/refs/replace" ] && [ -n "$(ls -A "${QUARANTINE_DIR}/refs/replace" 2>/dev/null || true)" ]; then
		fail "replace_refs" "replace refs present"
	fi

	commit_count=$(run_git_local --git-dir="${QUARANTINE_DIR}" rev-list --count --all 2>/dev/null | tr -d ' \n') \
		|| fail "count_failed" "commit count failed"
	case "$commit_count" in
	'' | *[!0-9]*) fail "count_failed" "invalid commit count" ;;
	esac
	[ "$commit_count" -le "$MAX_COMMITS" ] || fail "commit_limit" "too many commits"

	obj_stats=$(run_git_local --git-dir="${QUARANTINE_DIR}" cat-file --batch-check --batch-all-objects 2>/dev/null) \
		|| fail "objects_failed" "object enumeration failed"
	obj_count=$(printf '%s\n' "$obj_stats" | sed '/^$/d' | wc -l | tr -d ' ')
	[ "$obj_count" -le "$MAX_OBJECTS" ] || fail "object_limit" "too many objects"

	# Exact summed uncompressed object bytes (not compressed pack approximation).
	total_bytes=$(printf '%s\n' "$obj_stats" | awk '{
		if (NF >= 3 && $3 ~ /^[0-9]+$/) s += $3
		else exit 2
	}
	END { if (NR == 0) print 0; else print s+0 }')
	case "$total_bytes" in
	'' | *[!0-9]*) fail "objects_failed" "byte sum failed" ;;
	esac
	[ "$total_bytes" -le "$MAX_OBJECT_BYTES" ] || fail "object_bytes_limit" "reachable objects too large"

	# Per-blob size bound (no pipeline so set -e cannot swallow fail).
	tmp_stats="${STATE_ROOT}/tmp/obj-stats.txt"
	mkdir -p "${STATE_ROOT}/tmp"
	printf '%s\n' "$obj_stats" >"$tmp_stats"
	blob_over=0
	scan_err=0
	while IFS= read -r line; do
		[ -n "$line" ] || continue
		otype=$(printf '%s' "$line" | awk '{print $2}')
		osize=$(printf '%s' "$line" | awk '{print $3}')
		case "$osize" in
		'' | *[!0-9]*) scan_err=1; break ;;
		esac
		if [ "$otype" = "blob" ] && [ "$osize" -gt "$MAX_BLOB_BYTES" ]; then
			blob_over=1
			break
		fi
	done <"$tmp_stats"
	rm -f "$tmp_stats"
	[ "$scan_err" -eq 0 ] || fail "objects_failed" "object scan failed"
	[ "$blob_over" -eq 0 ] || fail "blob_limit" "blob too large"

	if [ -n "$expected_old" ]; then
		is_sha1 "$expected_old" || fail "invalid_old" "expected old sha invalid"
		if [ "$expected_old" != "$expected_tip" ]; then
			run_git_local --git-dir="${QUARANTINE_DIR}" merge-base --is-ancestor "$expected_old" "$expected_tip" >/dev/null 2>&1 \
				|| fail "ancestry" "proposed does not descend from expected old"
		fi
		run_git_local --git-dir="${QUARANTINE_DIR}" cat-file -e "${expected_old}^{commit}" >/dev/null 2>&1 \
			|| fail "old_missing" "expected old not in bundle"
	fi

	# Count path records across the inspected reachable change history — not just
	# the net tip diff. A history can churn >MAX_PATH_RECORDS paths and end with
	# a tiny net tree. Initial publication (no old) counts every commit on tip;
	# updates count commits in expected_old..expected_tip only.
	commits_file="${STATE_ROOT}/tmp/path-commits.txt"
	mkdir -p "${STATE_ROOT}/tmp"
	: >"$commits_file"
	if [ -n "$expected_old" ]; then
		run_git_local --git-dir="${QUARANTINE_DIR}" rev-list --reverse "${expected_old}..${expected_tip}" \
			>"$commits_file" 2>/dev/null \
			|| fail "paths_failed" "commit walk failed"
	else
		# Initial publication: all commits reachable from tip.
		run_git_local --git-dir="${QUARANTINE_DIR}" rev-list --reverse "${expected_tip}" \
			>"$commits_file" 2>/dev/null \
			|| fail "paths_failed" "commit walk failed"
	fi

	path_count=0
	while IFS= read -r commit || [ -n "$commit" ]; do
		[ -n "$commit" ] || continue
		# Bound per-commit listing so a single huge tree cannot materialize unbounded output.
		# --root includes the initial commit's full tree (plain diff-tree omits parentless commits).
		n=$(run_git_local --git-dir="${QUARANTINE_DIR}" diff-tree --root -r --name-only --no-commit-id "$commit" 2>/dev/null \
			| sed '/^$/d' \
			| head -n "$((MAX_PATH_RECORDS + 1))" \
			| wc -l \
			| tr -d ' ') || fail "paths_failed" "path enumeration failed"
		case "$n" in
		'' | *[!0-9]*) fail "paths_failed" "path count parse failed" ;;
		esac
		path_count=$((path_count + n))
		[ "$path_count" -le "$MAX_PATH_RECORDS" ] || fail "path_limit" "too many path records"
	done <"$commits_file"
	rm -f "$commits_file"

	reject_lfs_and_gitlinks

	# .gitattributes filter=lfs still rejected as belt-and-suspenders
	if run_git_local --git-dir="${QUARANTINE_DIR}" cat-file -e "${expected_tip}^{tree}:.gitattributes" 2>/dev/null; then
		attrs=$(run_git_local --git-dir="${QUARANTINE_DIR}" show "${expected_tip}:.gitattributes" 2>/dev/null || true)
		printf '%s' "$attrs" | grep -Eq 'filter=lfs' && fail "lfs" "lfs filter present"
	fi

	RESULT_JSON_EXTRA=$(printf '"ref":"%s","tip":"%s","commitCount":%s,"objectCount":%s,"pathCount":%s,"objectBytes":%s,"quarantine":true' \
		"$expected_ref" "$expected_tip" "$commit_count" "$obj_count" "$path_count" "$total_bytes")
}

cmd_validate_bundle() {
	expected_digest="${1:-}"
	expected_size="${2:-}"
	expected_ref="${3:-}"
	expected_tip="${4:-}"
	expected_old_raw="${5:-}"

	printf '%s' "$expected_digest" | grep -Eq '^[0-9a-f]{64}$' || fail "invalid_args" "digest"
	case "$expected_size" in
	'' | *[!0-9]*) fail "invalid_args" "size" ;;
	esac
	[ "$expected_size" -le "$MAX_BUNDLE_BYTES" ] || fail "bundle_limit" "bundle too large"
	is_heads_ref "$expected_ref" || fail "invalid_ref" "ref"
	is_sha1 "$expected_tip" || fail "invalid_tip" "tip"
	expected_old=""
	if [ "$expected_old_raw" != "-" ] && [ -n "$expected_old_raw" ]; then
		is_sha1 "$expected_old_raw" || fail "invalid_old" "old"
		expected_old="$expected_old_raw"
	fi

	prepare_home
	trap cleanup_state EXIT INT TERM

	bundle_path="${STATE_ROOT}/tmp/bundle.gitbundle"
	rm -f "$bundle_path"
	stream_stdin_capped "$bundle_path" "$expected_size" || fail "size_mismatch" "bundle size mismatch"
	chmod 600 "$bundle_path"

	actual_digest=$(hex_sha256_file "$bundle_path")
	[ "$actual_digest" = "$expected_digest" ] || fail "digest_mismatch" "bundle digest mismatch"

	import_bundle_into_quarantine "$bundle_path" "$expected_ref" "$expected_tip" "$expected_old"
	# Keep quarantine for subsequent push-validated in the same container life.
	trap - EXIT INT TERM
	rm -f "$bundle_path"
	printf '%s\n' "$expected_ref" >"${QUARANTINE_DIR}/.ditto-expected-ref"
	printf '%s\n' "$expected_tip" >"${QUARANTINE_DIR}/.ditto-expected-tip"
	printf '0\n' >"${PUSH_ATTEMPT_FILE}"
	chmod 600 "${QUARANTINE_DIR}/.ditto-expected-ref" "${QUARANTINE_DIR}/.ditto-expected-tip" "${PUSH_ATTEMPT_FILE}"
	ok_result "validated" "$RESULT_JSON_EXTRA"
}

cmd_push_validated() {
	owner="${1:-}"
	repo="${2:-}"
	ref="${3:-}"
	tip="${4:-}"
	is_safe_name "$owner" || fail "invalid_args" "owner"
	is_safe_name "$repo" || fail "invalid_args" "repo"
	is_heads_ref "$ref" || fail "invalid_ref" "ref"
	is_sha1 "$tip" || fail "invalid_tip" "tip"

	prepare_home
	[ -d "${QUARANTINE_DIR}" ] || fail "no_quarantine" "quarantine missing"
	[ -f "${QUARANTINE_DIR}/.ditto-expected-ref" ] || fail "no_quarantine" "quarantine incomplete"
	stored_ref=$(cat "${QUARANTINE_DIR}/.ditto-expected-ref")
	stored_tip=$(cat "${QUARANTINE_DIR}/.ditto-expected-tip")
	[ "$stored_ref" = "$ref" ] || fail "ref_mismatch" "quarantine ref mismatch"
	[ "$stored_tip" = "$tip" ] || fail "tip_mismatch" "quarantine tip mismatch"

	attempts=0
	if [ -f "${PUSH_ATTEMPT_FILE}" ]; then
		attempts=$(cat "${PUSH_ATTEMPT_FILE}" | tr -d ' \n' || echo 0)
		case "$attempts" in
		'' | *[!0-9]*) attempts=0 ;;
		esac
	fi
	# At most one authorized retry after a failed/ambiguous first push.
	[ "$attempts" -le 1 ] || fail "retry_exhausted" "push retry exhausted"

	url="https://github.com/${owner}/${repo}.git"
	refspec="${tip}:${ref}"

	err_file="${STATE_ROOT}/tmp/push.err"
	out_file="${STATE_ROOT}/tmp/push.out"
	mkdir -p "${STATE_ROOT}/tmp"
	: >"$err_file"
	: >"$out_file"
	set +e
	run_git_net --git-dir="${QUARANTINE_DIR}" push --no-tags --no-follow-tags \
		--no-recurse-submodules --receive-pack=git-receive-pack \
		"$url" "$refspec" >"$out_file" 2>"$err_file"
	rc=$?
	set -e

	attempts=$((attempts + 1))
	printf '%s\n' "$attempts" >"${PUSH_ATTEMPT_FILE}"

	if [ "$rc" -eq 0 ]; then
		cleanup_state
		ok_result "pushed" "$(printf '"ref":"%s","tip":"%s","exitCode":0' "$ref" "$tip")"
	fi

	# Preserve quarantine after first failure for the one authorized retry.
	if [ "$attempts" -eq 1 ]; then
		fail "push_failed" "push failed" "$(printf '"exitCode":%s,"retryable":true' "$rc")"
	fi
	# Second failure: clean up.
	cleanup_state
	fail "push_failed" "push failed" "$(printf '"exitCode":%s,"retryable":false' "$rc")"
}

cmd_ls_remote_ref() {
	owner="${1:-}"
	repo="${2:-}"
	ref="${3:-}"
	is_safe_name "$owner" || fail "invalid_args" "owner"
	is_safe_name "$repo" || fail "invalid_args" "repo"
	is_heads_ref "$ref" || fail "invalid_ref" "ref"
	prepare_home

	url="https://github.com/${owner}/${repo}.git"
	out_file="${STATE_ROOT}/tmp/ls.out"
	err_file="${STATE_ROOT}/tmp/ls.err"
	mkdir -p "${STATE_ROOT}/tmp"
	set +e
	run_git_net ls-remote --heads "$url" "$ref" >"$out_file" 2>"$err_file"
	rc=$?
	set -e
	if [ "$rc" -ne 0 ]; then
		fail "ls_remote_failed" "ls-remote failed" "$(printf '"exitCode":%s' "$rc")"
	fi
	lines=$(sed '/^$/d' "$out_file" | wc -l | tr -d ' ')
	if [ "$lines" = "0" ]; then
		ok_result "absent" '"present":false,"sha":null'
	fi
	if [ "$lines" != "1" ]; then
		fail "ls_remote_ambiguous" "unexpected ls-remote lines"
	fi
	sha=$(awk 'NR==1 {print $1}' "$out_file")
	got_ref=$(awk 'NR==1 {$1=""; sub(/^ /,""); print}' "$out_file")
	is_sha1 "$sha" || fail "ls_remote_invalid" "invalid sha"
	[ "$got_ref" = "$ref" ] || fail "ls_remote_ref" "ref mismatch"
	ok_result "present" "$(printf '"present":true,"sha":"%s"' "$sha")"
}

cmd_fetch_ref() {
	cmd_ls_remote_ref "$@"
}

usage_fail() {
	fail "unknown_command" "unknown or invalid command"
}

main() {
	cmd="${1:-}"
	[ -n "$cmd" ] || usage_fail
	shift || true
	case "$cmd" in
	hold)
		cmd_hold
		;;
	scan-canary)
		[ "$#" -eq 0 ] || fail "invalid_args" "scan-canary arity"
		cmd_scan_canary
		;;
	validate-bundle)
		[ "$#" -eq 5 ] || fail "invalid_args" "validate-bundle arity"
		cmd_validate_bundle "$@"
		;;
	push-validated)
		[ "$#" -eq 4 ] || fail "invalid_args" "push-validated arity"
		cmd_push_validated "$@"
		;;
	ls-remote-ref)
		[ "$#" -eq 3 ] || fail "invalid_args" "ls-remote-ref arity"
		cmd_ls_remote_ref "$@"
		;;
	fetch-ref)
		[ "$#" -eq 3 ] || fail "invalid_args" "fetch-ref arity"
		cmd_fetch_ref "$@"
		;;
	*)
		usage_fail
		;;
	esac
}

main "$@"
